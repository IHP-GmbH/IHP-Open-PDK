#==========================================
# ------- CAP_CMOMF CONNECTIONS -----------
#==========================================

logger.info('Starting CAP_CMOMF CONNECTIONS')

# Connect each metal's port pins ONLY to that same metal, as cap_cmomi does.
# The comb of each polarity is already tied through its own via stacks by
# general_connections, so per-layer pin connection is sufficient for net
# tracing, and it keeps the two terminals from ever bridging through a merged
# port region. This is the one place the closed PR #39 got it wrong: it joined
# metal1_pin..metal4_pin into a single region and connected that to every
# metal, which shorts any device whose pins are not on the same layer.
connect(cap_cmomf_m1_ports, metal1_con)
connect(cap_cmomf_m2_ports, metal2_con)
connect(cap_cmomf_m3_ports, metal3_con)
connect(cap_cmomf_m4_ports, metal4_con)
connect(cap_cmomf_m5_ports, metal5_con)
