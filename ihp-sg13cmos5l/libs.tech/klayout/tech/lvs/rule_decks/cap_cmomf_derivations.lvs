#========================================
# ------- CAP_CMOMF DERIVATIONS ---------
#========================================

logger.info('Starting CAP_CMOMF DERIVATIONS')

# cap_cmomf is the metal fringe (finger) MoM capacitor, the sibling of
# cap_cmomi on the same Metal1..Metal4 stack. It is identified by its OWN
# recognition marker, Recog.momf (GDS 99/40), which the PCell paints over the
# full device area.
#
# It cannot share Recog.mom (99/39) with cap_cmomi: the shared g2 deck
# cap_cmomi_derivations.lvs claims that marker unconditionally
# ('cap_cmomi owns Recog.mom by design'), so a single cap_cmomf geometry would
# be recognised by both extractors and LVS would fail on a device count
# mismatch.
#
# TEMPORARY, cmos5l-local: 99/40 is declared here rather than in
# layers_definitions.lvs, which is a symlink into the sibling ihp-sg13g2.
# When cap_cmomf is upstreamed to g2 this line moves next to recog_mom there
# (and the matching Recog.momf entry is already in sg13cmos5l.lyp).
recog_momf = get_polygons(99, 40)
count = recog_momf.count()
logger.info("recog_momf has #{count} polygons")

cap_cmomf_marker = recog_momf

# Device marker for extraction
cap_cmomf_dev_mk = cap_cmomf_marker

# Port identification: metal pin shapes within the device marker.
# The PCell places two MkPin shapes (PLUS = pin 1 on the left edge,
# MINUS = pin 2 on the top edge), both on the mmax metal.
#
# Per-metal port layers, like cap_cmomi: keeping the metal identity lets
# connectivity tie each pin ONLY to its own metal. cap_cmomf never stacks its
# two pins, so a merged port layer would work today, but mirroring the sibling
# keeps both devices on one pattern and keeps the shared CapMomExtractor
# signature identical. m5p is empty on this four-metal PDK and is passed for
# exactly that reason.
cap_cmomf_m1_ports = metal1_pin.and(cap_cmomf_marker)
cap_cmomf_m2_ports = metal2_pin.and(cap_cmomf_marker)
cap_cmomf_m3_ports = metal3_pin.and(cap_cmomf_marker)
cap_cmomf_m4_ports = metal4_pin.and(cap_cmomf_marker)
cap_cmomf_m5_ports = metal5_pin.and(cap_cmomf_marker)
