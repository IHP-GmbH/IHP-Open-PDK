#================================================
# -------- CAP_CMOMF SHARED-DECK REGISTRATION ---
#================================================

# TEMPORARY, cmos5l-local. Two shared decks have to know about cap_cmomf and
# both are symlinks into the sibling ihp-sg13g2:
#
#   globals.lvs        PREFIX_MAP, which custom_writer.lvs reads to prefix the
#                      extracted device. Without an entry it falls back to the
#                      raw device id instead of 'C'.
#   custom_reader.lvs  cap_cmim_model_field?, which decides how many terminals
#                      a C line carries. Without cap_cmomf in that list, the
#                      model token of 'C1 PLUS MINUS cap_cmomf w=.. l=..' is
#                      parsed as a value, the token is dropped, and the device
#                      degrades to a plain capacitor: a device-class mismatch.
#
# The closed PR #39 handled this by replacing the globals.lvs symlink with a
# copy of the file. That silently reverted eleven PREFIX_MAP entries g2 had
# added in the meantime (the metal resistors, both moscaps, cap_cmomi and the
# inductor). This deck instead EXTENDS whatever the shared decks provide, so a
# later g2 addition is inherited rather than frozen. Delete the whole file, and
# its include, once cap_cmomf is upstreamed to g2.
#
# Scope note: rule decks are loaded with instance_eval into the LVS engine, so
# PREFIX_MAP and CustomReader live in the engine's singleton class and not in
# Object. Module.nesting.first is that class; Object.send(:remove_const, ...)
# would raise NameError here.

logger.info('Registering cap_cmomf with the shared LVS globals')

cap_cmomf_scope = Module.nesting.first

unless cap_cmomf_scope.const_defined?(:PREFIX_MAP, false)
  raise 'cap_cmomf: PREFIX_MAP is not defined in this scope. The shared ' \
        'globals.lvs moved or is no longer included from custom_classes.lvs, ' \
        'and rule_decks/cap_cmomf_registration.lvs has to follow it.'
end

cap_cmomf_prefix_map = PREFIX_MAP.merge('cap_cmomf' => 'C').freeze
cap_cmomf_scope.send(:remove_const, :PREFIX_MAP)
cap_cmomf_scope.const_set(:PREFIX_MAP, cap_cmomf_prefix_map)

unless CustomReader.method_defined?(:cap_cmim_model_field?)
  raise 'cap_cmomf: CustomReader#cap_cmim_model_field? no longer exists. The ' \
        'shared custom_reader.lvs changed its 2-terminal capacitor whitelist, ' \
        'and rule_decks/cap_cmomf_registration.lvs has to follow it.'
end

class CustomReader
  # Extend the shared 2-terminal DeviceCustomMIM model list with cap_cmomf.
  # Same behaviour as upstream, one more accepted model name.
  def cap_cmim_model_field?(field)
    ['cap_cmim', 'cap_cmomi', 'cap_cmomf'].include?(canonical_cap_model(field))
  end
end
