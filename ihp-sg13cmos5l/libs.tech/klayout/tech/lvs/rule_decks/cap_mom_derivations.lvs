#========================================
# -------- CAP_MOM DERIVATIONS ---------
#========================================

logger.info('Starting CAP_MOM DERIVATIONS')

# The cap_mom device is identified by the recog_mom marker (Recog.mom, GDS 99/39).
# The PCell paints this marker over the full device area. cap_mom owns Recog.mom
# by design: it is the MOM capacitor. No other device keys on 99/39 on this branch.
#
# INTEGRATION NOTE: the cap_mfringe device (developed on a separate feature branch)
# also keys on Recog.mom 99/39. When the two features are integrated, cap_mfringe
# must be re-homed to its own recognition datatype (recommend Recog.mfringe 99/40)
# so both devices extract distinctly. That change belongs on the cap_mfringe side.
cap_mom_marker = recog_mom

# Device marker for extraction
cap_mom_dev_mk = cap_mom_marker

# Port identification: metal pin shapes within the device marker.
# The PCell places two MkPin shapes (PLUS = pin 1, MINUS = pin 2). For 'double'
# both sit on the top metal (different x); for 'same' they are STACKED on
# adjacent metals (mmax over mmax-1) at the same x,y.
#
# Per-metal port layers: keep the metal identity so connectivity can tie each
# pin ONLY to its own metal. Two stacked pins (same x,y, different metals) would
# otherwise bridge if a single merged port layer were connected to every metal.
cap_mom_m1_ports = metal1_pin.and(cap_mom_marker)
cap_mom_m2_ports = metal2_pin.and(cap_mom_marker)
cap_mom_m3_ports = metal3_pin.and(cap_mom_marker)
cap_mom_m4_ports = metal4_pin.and(cap_mom_marker)
