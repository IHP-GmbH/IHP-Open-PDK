#========================================
# -------- CAP_MOM EXTRACTION ----------
#========================================

logger.info('Extracting cap_mom device')

extract_devices(CapMomExtractor.new('cap_mom'), {
                  'core' => cap_mom_marker,
                  'm1p' => cap_mom_m1_ports,
                  'm2p' => cap_mom_m2_ports,
                  'm3p' => cap_mom_m3_ports,
                  'm4p' => cap_mom_m4_ports,
                  'dev_mk' => cap_mom_dev_mk
                })
