**************************************
* Device: dantenna
* Testfield: T262, IHP SG13S, Lot AWL403#A, Wafer 19, Chip 4,7, Segment S350B
* DUTs: D1 (area), D2 (perimeter) and D4 (corners)
* Temperature range: -40 degC ... +125 degC, DC range: -15 V ... 1 V
* model is designed for reverse direction of the diodes, NO statistics
*  DEV_A = area of the diode in um*um
*  DEV_P = perimeter of the diode in um
*  DEV_C = number of corners (default=4)
*
* Changes 2026-10 vs. previous version:
*  - level=3 (ibv scales with area), nbv removed
*  - tlev=1 tcv=-0.001, eg=1.20 (temperature dependence of bv and is)
*  - dcorner: cj0=5e-18 added (convergence aid)
**************************************

*########################## dantenna models ############################

.MODEL darea D (level=3 tnom=27 is=2.315E-019 n=1.009 ik=1.434E-007 rs=2.193E+005 cj0=9.371E-016 m=0.3036
+ vj=0.696 fc=0.5 bv=11.64 ibv=3.458E-007 tlev=1 tcv=-0.001 isr=7.413E-019 xti=5.039 eg=1.20
+ trs=0 trs2=0 tt=7.009E-007)
.MODEL dperim D (level=3 tnom=27 is=3.851E-021 n=1.022 rs=1.688E+006 ik=7.838E-008 isr=1.011E-017 xti=3
+ bv=31.86 ibv=6.115E-014 cj0=1.821E-017 m=0.01923 vj=0.598 eg=1.20 tt=7.009E-007)
.MODEL dcorner D (level=3 tnom=27 is=6.502E-021 n=1 rs=4.857E+005 ik=1E-006 isr=0 xti=3
+ bv=11.64 ibv=3.458E-007 cj0=5e-18 m=0.5 vj=0.7 eg=1.20)

.subckt dantenna 1 2 l=780n w=780n
*                (anode  cathode)
*      (substrate/pWell  NSD)
.param DEV_A={(l*w)/1p} DEV_P={(l+w)/0.5u} DEV_C=4
D1 1 2 darea   area={DEV_A}
D2 1 2 dperim  area={DEV_P}
D3 1 2 dcorner area={DEV_C}
.ends dantenna


**************************************
* Device: dpantenna
* Testfield: T262, IHP SG13S, Lot AWL403#A, Wafer 19, Chip 4,7, Segment S351B
* DUTs: D1 (area), D2 (perimeter) and D4 (corners)
* Temperature range: -40 degC ... +125 degC, DC range: -15 V ... 1 V
* model is designed for reverse direction of the diodes, NO statistics
* bipolar effect in forward direction is NOT modeled
*  DEV_A = area of the diode in um*um
*  DEV_P = perimeter of the diode in um
*  DEV_C = number of corners (default=4)
*
* Changes 2026-10 vs. previous version:
*  - level=3 (ibv scales with area), nbv removed
*  - tlev=1 tcv=-0.001, eg=1.20 (temperature dependence of bv and is)
*  - dpcorner: cj0=3e-18 added (convergence aid)
**************************************

*########################## dpantenna models ###########################

.MODEL dparea D (level=3 tnom=27 is=8.569E-020 n=1.003 ik=2.957E-007 rs=1.728E+005 cj0=8.252E-016 m=0.3171
+ vj=0.6628 fc=0.5 bv=12.14 ibv=1E-006 tlev=1 tcv=-0.001 isr=2.421E-019 xti=4.56 eg=1.20
+ trs=0 trs2=0 tt=1E-012)
.MODEL dpperim D (level=3 tnom=27 is=1.186E-020 n=1.006 rs=1.577E+006 ik=2.158E-008 isr=7.211E-018 xti=4.118
+ bv=27.26 ibv=1.832E-011 cj0=3.657E-017 m=0.1512 vj=0.5241 eg=1.20 tt=1E-012)
.MODEL dpcorner D (level=3 tnom=27 is=6.965E-021 n=1 rs=4.734E+005 ik=1.19E-008 isr=0 xti=3
+ cj0=3e-18 m=0.5 vj=0.7 eg=1.20)

.subckt dpantenna 1 2 l=780n w=780n
*              (PSD  nWell)
*             (anode  cathode)
.param DEV_A={(l*w)/1p} DEV_P={(l+w)/0.5u} DEV_C=4
D1 1 2 dparea   area={DEV_A}
D2 1 2 dpperim  area={DEV_P}
D3 1 2 dpcorner area={DEV_C}
.ends dpantenna
