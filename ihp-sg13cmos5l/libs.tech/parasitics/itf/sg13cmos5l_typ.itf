$ Derived from ihp-sg13g2/libs.tech/parasitics/itf/sg13g2_typ.itf with the
$ layer stack of SG13CMOS5L_os_process_spec.pdf Rev. 0.2 Fig. 1.1/1.2:
$ no Metal5 and no TopMetal2, TopMetal1 sits on Metal4 (TopVia1 0.85).
$ ITF semantics: a CONDUCTOR sits on the DIELECTRIC listed below it and is
$ embedded in the DIELECTRIC listed above it, e.g. ox1 (0.96) = Metal1
$ (0.42) + Via1 gap (0.54), ox4 (1.34) = Metal4 (0.49) + TopVia1 (0.85),
$ oxTopMetal1 (3.5) = TopMetal1 (2.0) + 1.5 passivation oxide.
$

TECHNOLOGY = sg13cmos5l


DIELECTRIC air              {THICKNESS=5.0    ER=1.0  }
DIELECTRIC nitTop           {THICKNESS=0.4    ER=6.6  }
DIELECTRIC oxTopMetal1      {THICKNESS=3.5    ER=4.1  }
CONDUCTOR TopMetal1         {THICKNESS=2.0    WMIN=1.5 SMIN=1.5 RPSQ=0.018 }
DIELECTRIC ox4	            {THICKNESS=1.34   ER=4.1 } 
CONDUCTOR Metal4            {THICKNESS=0.490  WMIN=0.2 SMIN=0.21 RPSQ=0.088 }
DIELECTRIC ox3 	            {THICKNESS=1.03   ER=4.1 }
CONDUCTOR Metal3            {THICKNESS=0.490  WMIN=0.2 SMIN=0.21 RPSQ=0.088 }
DIELECTRIC ox2 	            {THICKNESS=1.03   ER=4.1 }
CONDUCTOR Metal2            {THICKNESS=0.490  WMIN=0.2 SMIN=0.21 RPSQ=0.088 }
DIELECTRIC ox1 	            {THICKNESS=0.960  ER=4.1 }
CONDUCTOR Metal1            {THICKNESS=0.420  WMIN=0.16 SMIN=0.18 RPSQ=0.110 }
DIELECTRIC ild0 	          {THICKNESS=0.59   ER=4.1 }
DIELECTRIC nitride 	        {THICKNESS=0.05   ER=6.5 }
CONDUCTOR GatPoly           {THICKNESS=0.160  WMIN=0.13 SMIN=0.18 RPSQ=7.0 LAYER_TYPE=GATE}
DIELECTRIC fox 		          {THICKNESS=0.4    ER=3.95 }
CONDUCTOR  Activ   	        {THICKNESS=0.398  WMIN=0.15 SMIN=0.21 RPSQ=1 LAYER_TYPE=DIFFUSION}
DIELECTRIC Trench	          {THICKNESS=0.400  ER=8.85 }

VIA TopVia1 		            { FROM=Metal4    TO=TopMetal1  AREA=0.1764 RPV=2.2 }
VIA Via3                    { FROM=Metal3    TO=Metal4     AREA=0.0361 RPV=9 }
VIA Via2                    { FROM=Metal2    TO=Metal3     AREA=0.0361 RPV=9 }
VIA Via1                    { FROM=Metal1    TO=Metal2     AREA=0.0361 RPV=9 }

VIA ContIntActiv            { FROM=Activ	   TO=Metal1 	   AREA=0.0256 RPV=17.0 }
VIA Cont                    { FROM=GatPoly	 TO=Metal1 	   AREA=0.0256 RPV=15.0 }
