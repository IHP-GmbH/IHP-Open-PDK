      voltage_name : "vdd";
    }
    pg_pin (vss) {
      pg_type : primary_ground;
      voltage_name : "vss";
    }
    leakage_power () {
      value : 1034.9;
      when : "!padres&!pad";
      related_pg_pin : iovdd;
    }
    leakage_power () {
      value : 0;
      when : "!padres&!pad";
      related_pg_pin : vdd;
    }
    leakage_power () {
      value : 1034.9;
      related_pg_pin : iovdd;
    }
    leakage_power () {
      value : 0;
      related_pg_pin : vdd;
    }
    pin (pad) {
      direction : "inout";
      drive_current : 27000;
      input_voltage : "pad";
      is_pad : true;
      related_ground_pin : iovss;
      related_power_pin : iovdd;
      max_capacitance : 30000;
      capacitance : 0.766244;
      rise_capacitance : 0.759216;
      rise_capacitance_range (0.759216, 0.759216);
      fall_capacitance : 0.773273;
      fall_capacitance_range (0.773273, 0.773273);
      timing () {
                related_pin : "pad";
                timing_type : combinational;
                cell_rise (delay_template_2x2) {
                    values ( \
                        "1000, 1000", \
                        "1000, 1000" \
                    );
                }
                rise_transition (delay_template_2x2) {
                    values ( \
                        "200, 200", \
                        "200, 200" \
                    );
                }
                cell_fall (delay_template_2x2) {
                    values ( \
                        "1000, 1000", \
                        "1000, 1000" \
                    );
                }
                fall_transition (delay_template_2x2) {
                    values ( \
                        "200, 200", \
                        "200, 200" \
                    );
                }
            }
    }
