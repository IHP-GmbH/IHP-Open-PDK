    }
    pg_pin (vss) {
      pg_type : primary_ground;
      voltage_name : "vss";
    }
    leakage_power () {
      value : 1034.9;
      when : "!padres&!pad";
      related_pg_pin : iovdd;
    }
    leakage_power () {
      value : 0;
      when : "!padres&!pad";
      related_pg_pin : vdd;
    }
    leakage_power () {
