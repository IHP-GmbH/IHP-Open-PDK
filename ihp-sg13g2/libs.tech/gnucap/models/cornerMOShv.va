    localparam real sg13g2_hv_pmos_rsw1 = 1.0000;
    localparam real sg13g2_hv_pmos_mueo = 0.9605;
    localparam real sg13g2_hv_pmos_dphibo = 1.0010;
    localparam real sg13g2_hv_pmos_dphibl = 0.9504;
    localparam real sg13g2_hv_pmos_dphibw = 1.4080;
    localparam real sg13g2_hv_pmos_dphiblw = -0.1693;
    localparam real sg13g2_hv_pmos_bgidlo = 0.8409;
    localparam real sg13g2_hv_pmos_thesato = 1.0000;
    localparam real sg13g2_hv_pmos_thesatl = 0.4814;
    localparam real sg13g2_hv_pmos_thesatw = 5.7745;
    localparam real sg13g2_hv_pmos_thesatlw = 1.0000;
    localparam real sg13g2_hv_pmos_csl = 1.0000;
    localparam real sg13g2_hv_pmos_toxo = 1.0000;
