//
// Corner naming scheme: typical mean=tt, worst case=ss, best case=ff, combinations sf, fs, ...
// Digit Devices

//******************************************************************************
// MOSHV corner modules
//
// Adapted from `ngspice/models/cornerMOShv.lib`
//
// Modifications:
// - Removed mismatch corners; mismatch is implemented in paramsets
// - Moved global process-variation parameters into the statistical corner
//******************************************************************************

(* desc = "Typical High-Voltage SG13G2 MOS corner (tt: typical n, typical p)" *)
module moshv_tt();
    // nmos
    localparam real sg13g2_hv_nmos_vfbo = 1.0;
    localparam real sg13g2_hv_nmos_rsgo = 1.0000;
    localparam real sg13g2_hv_nmos_rsw1 = 0.7886;
