    localparam real sg13g2_hv_nmos_thesatl = 1.0350;
    localparam real sg13g2_hv_nmos_thesatw = 1.0000;
    localparam real sg13g2_hv_nmos_thesatlw = 1.6050;
    localparam real sg13g2_hv_nmos_toxo = 1.0000;
    localparam real sg13g2_hv_nmos_toxovo = 1.0000;
    localparam real sg13g2_hv_nmos_cjorbot = 1.0000;
    localparam real sg13g2_hv_nmos_cjorsti = 1.0000;
