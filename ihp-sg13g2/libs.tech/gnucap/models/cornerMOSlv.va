    localparam real sg13g2_lv_pmos_thesatw_sig  = 0.0427 * sg13g2_lv_pmos_thesatw_nom;
    localparam real sg13g2_lv_pmos_thesatlw_sig = 0.1667 * sg13g2_lv_pmos_thesatlw_nom;
    localparam real sg13g2_lv_pmos_toxo_sig     = 0.0133 * sg13g2_lv_pmos_toxo_nom;
    localparam real sg13g2_lv_pmos_toxovo_sig   = 0.0133 * sg13g2_lv_pmos_toxovo_nom;
    localparam real sg13g2_lv_pmos_cjorbot_sig  = 0.0267 * sg13g2_lv_pmos_cjorbot_nom;
    localparam real sg13g2_lv_pmos_cjorsti_sig  = 0.0267 * sg13g2_lv_pmos_cjorsti_nom;
    localparam real sg13g2_lv_pmos_cjorgat_sig  = 0.0267 * sg13g2_lv_pmos_cjorgat_nom;
    // pmos params with global process variation
    localparam real sg13g2_lv_pmos_vfbo     = $rdist_normal(seed + 18, sg13g2_lv_pmos_vfbo_nom,     sg13g2_lv_pmos_vfbo_sig,     "global");
    localparam real sg13g2_lv_pmos_ctl      = $rdist_normal(seed + 19, sg13g2_lv_pmos_ctl_nom,      sg13g2_lv_pmos_ctl_sig,      "global");
    localparam real sg13g2_lv_pmos_rsw1     = $rdist_normal(seed + 20, sg13g2_lv_pmos_rsw1_nom,     sg13g2_lv_pmos_rsw1_sig,     "global");
    localparam real sg13g2_lv_pmos_muew     = $rdist_normal(seed + 21, sg13g2_lv_pmos_muew_nom,     sg13g2_lv_pmos_muew_sig,     "global");
    localparam real sg13g2_lv_pmos_dphibo   = $rdist_normal(seed + 22, sg13g2_lv_pmos_dphibo_nom,   sg13g2_lv_pmos_dphibo_sig,   "global");
    localparam real sg13g2_lv_pmos_dphibl   = $rdist_normal(seed + 23, sg13g2_lv_pmos_dphibl_nom,   sg13g2_lv_pmos_dphibl_sig,   "global");
    localparam real sg13g2_lv_pmos_dphibw   = $rdist_normal(seed + 24, sg13g2_lv_pmos_dphibw_nom,   sg13g2_lv_pmos_dphibw_sig,   "global");
    localparam real sg13g2_lv_pmos_dphiblw  = $rdist_normal(seed + 25, sg13g2_lv_pmos_dphiblw_nom,  sg13g2_lv_pmos_dphiblw_sig,  "global");
    localparam real sg13g2_lv_pmos_themuo   = $rdist_normal(seed + 26, sg13g2_lv_pmos_themuo_nom,   sg13g2_lv_pmos_themuo_sig,   "global");
    localparam real sg13g2_lv_pmos_thesatl  = $rdist_normal(seed + 27, sg13g2_lv_pmos_thesatl_nom,  sg13g2_lv_pmos_thesatl_sig,  "global");
    localparam real sg13g2_lv_pmos_thesatw  = $rdist_normal(seed + 28, sg13g2_lv_pmos_thesatw_nom,  sg13g2_lv_pmos_thesatw_sig,  "global");
    localparam real sg13g2_lv_pmos_thesatlw = $rdist_normal(seed + 29, sg13g2_lv_pmos_thesatlw_nom, sg13g2_lv_pmos_thesatlw_sig, "global");
    localparam real sg13g2_lv_pmos_toxo     = $rdist_normal(seed + 30, sg13g2_lv_pmos_toxo_nom,     sg13g2_lv_pmos_toxo_sig,     "global");
    localparam real sg13g2_lv_pmos_toxovo   = $rdist_normal(seed + 31, sg13g2_lv_pmos_toxovo_nom,   sg13g2_lv_pmos_toxovo_sig,   "global");
    localparam real sg13g2_lv_pmos_cjorbot  = $rdist_normal(seed + 32, sg13g2_lv_pmos_cjorbot_nom,  sg13g2_lv_pmos_cjorbot_sig,  "global");
    localparam real sg13g2_lv_pmos_cjorsti  = $rdist_normal(seed + 33, sg13g2_lv_pmos_cjorsti_nom,  sg13g2_lv_pmos_cjorsti_sig,  "global");
    localparam real sg13g2_lv_pmos_cjorgat  = $rdist_normal(seed + 34, sg13g2_lv_pmos_cjorgat_nom,  sg13g2_lv_pmos_cjorgat_sig,  "global");
    // svaricaplv
    localparam real sg13g2_lv_svaricap_lap = 1.082;
    localparam real sg13g2_lv_svaricap_toxo = 1;
endmodule

// TODO: mm params are hard coded into paramsets, pull out of module instead?
(* desc = "Low-Voltage SG13G2 MOS mismatch parameters" *)
module moslv_mm();
    // nmos
    localparam real sg13g2_lv_nmos_delvto_mm  = 0.0039;
    localparam real sg13g2_lv_nmos_factuo_mm  = 0.005;
    localparam real sg13g2_lv_nmos_dw_mm      = 4e-9;
    localparam real sg13g2_lv_nmos_dl_mm      = 2e-9;
    // pmos
