//******************************************************************************
// isolbox dpwdnw paramsets
//
// Adapted from model declarations in ngspice/models/diode.lib
//******************************************************************************


(* desc = "isolbox p-well/deep-nwell inner diode" *)
paramset dinner_mod sp_diode
    (* desc = "Area scale factor" *)
    parameter real area = 1 from [0:inf);
    (* desc = "Perimeter scale factor" *)
    parameter real pj = 0 from [0:inf);

    .area = area;
    .pj   = pj;
    .level = 1;
    .tlev  = 2;
    .tlevc = 0;
    .tnom  = 27;
    .is   = 1.5e-19;
    .n    = 1.02;
    .ikf  = 100e-9;
    .xti  = 1.9;
    .bv   = 9.7;
    .ibv  = 1e-12;
    .nbv  = 0.1;
    .tcv  = -698.557e-6;
    .rs   = 5e5;
endparamset

(* desc = "isolbox p-well/deep-nwell sidewall diode" *)
paramset dinneredge_mod sp_diode
    (* desc = "Area scale factor" *)
    parameter real area = 1 from [0:inf);
    (* desc = "Perimeter scale factor" *)
    parameter real pj = 0 from [0:inf);

    .area = area;
    .pj   = pj;
    .level = 1;
    .tlev  = 2;
    .tlevc = 0;
    .tnom  = 27;
    .is   = 3.89e-20;
    .jsw  = 7.239e-20;
    .n    = 1.01;
    .ikf  = 3e-6;
    .xti  = 1.529;
    .bv   = 9.7;
    .ibv  = 1e-12;
    .nbv  = 0.1;
    .tcv  = -698.557e-6;
    .isr  = 20e-18;
    .rs   = 5e4;
endparamset

(* desc = "isolbox p-well/deep-nwell low-field reverse diode" *)
paramset dinrevl_mod sp_diode
    (* desc = "Area scale factor" *)
    parameter real area = 1 from [0:inf);
    (* desc = "Perimeter scale factor" *)
    parameter real pj = 0 from [0:inf);

    .area = area;
    .pj   = pj;
    .level = 1;
    .tlev  = 2;
    .tlevc = 0;
    .tnom  = 27;
    .is  = 1e-18;
    .n   = 100;
    .xti = 2200;
endparamset

(* desc = "isolbox p-well/deep-nwell reverse sidewall diode" *)
paramset dinrevlside_mod sp_diode
    (* desc = "Area scale factor" *)
