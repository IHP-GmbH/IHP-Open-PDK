    (* desc = "Perimeter scale factor" *)
    parameter real pj = 0 from [0:inf);

    .area = area;
    .pj   = pj;
    .level = 1;
    .tlev  = 2;
    .tlevc = 0;
    .tnom  = 27;
    .is  = 10e-18;
    .n   = 100;
    .xti = 2200;
endparamset

(* desc = "isolbox p-well/deep-nwell high-field reverse diode" *)
paramset dinrevh_mod sp_diode
    (* desc = "Area scale factor" *)
    parameter real area = 1 from [0:inf);
    (* desc = "Perimeter scale factor" *)
    parameter real pj = 0 from [0:inf);

    .area = area;
    .pj   = pj;
    .level = 1;
    .tlev  = 2;
    .tlevc = 0;
    .tnom  = 27;
    .is  = 3e-21;
    .n   = 30;
    .xti = 700;
endparamset

(* desc = "isolbox p-well/deep-nwell area capacitance diode" *)
paramset dincaparea_mod sp_diode
    (* desc = "Area scale factor" *)
    parameter real area = 1 from [0:inf);
    (* desc = "Perimeter scale factor" *)
    parameter real pj = 0 from [0:inf);

    .area = area;
    .pj   = pj;
    .level = 1;
    .tlev  = 2;
    .tlevc = 0;
    .tnom  = 27;
    .is   = 1e-25;
    .cjo  = 967.2e-18;
    .cjsw = 436e-18;
    .m    = 0.3436;
    .mjsw = 0.3234;
    .vj   = 0.7312;
    .php  = 0.7036;
endparamset
