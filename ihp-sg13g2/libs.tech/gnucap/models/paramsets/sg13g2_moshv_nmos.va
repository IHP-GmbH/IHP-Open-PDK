(* desc="sg13g2 High-Voltage NMOS paramset" *)
paramset sg13g2_hv_nmos_psp PSP103VA
    (* desc = "Device width", units = "m" *)
    parameter real w = 0.35u from (0:inf);
    (* desc = "Device length", units = "m" *)
    parameter real l = 0.45u from (0:inf);
    (* desc = "Number of fingers" *)
    parameter integer ng = 1 from [1:inf);
    (* desc = "Instance multiplicity" *)
    parameter real m = 1.0;
    (* desc = "Source diffusion area", units = "m^2" *)
    parameter real as = 0.0 from [0:inf);
    (* desc = "Drain diffusion area", units = "m^2" *)
    parameter real ad = 0.0 from [0:inf);
    (* desc = "Source diffusion perimeter", units = "m" *)
