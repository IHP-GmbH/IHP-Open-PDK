(* desc="sg13g2 High-Voltage PMOS RF paramset" *)
paramset sg13g2_hv_pmos_psp PSPNQS103VA
    (* desc = "Device width", units = "m" *)
    parameter real w = 0.35u from (0:inf);
    (* desc = "Device length", units = "m" *)
    parameter real l = 0.40u from (0:inf);
    (* desc = "Number of fingers" *)
    parameter integer ng = 1 from [1:inf);
    (* desc = "Instance multiplicity" *)
    parameter real m = 1.0 from (0:inf);
    (* desc = "Source diffusion area", units = "m^2" *)
    parameter real as = 0.0 from [0:inf);
    (* desc = "Drain diffusion area", units = "m^2" *)
    parameter real ad = 0.0 from [0:inf);
    (* desc = "Source diffusion perimeter", units = "m" *)
    parameter real ps = 0.0 from [0:inf);
    (* desc = "Drain diffusion perimeter", units = "m" *)
    parameter real pd = 0.0 from [0:inf);
    (* desc = "Temperature offset w.r.t. ambient temperature" *)
    parameter real trise = 0.0;
    (* desc = "Threshold voltage offset" *)
    parameter real delvto = 0.0;
    (* desc = "Mobility scaling factor" *)
    parameter real factuo = 1.0 from (0:inf);
    (* desc = "Enable pre-layout parasitic modelling" *)
    parameter integer pre_layout = 1 from [0:1];
    (* desc = "Select the PSP103 RF/NQS model" *)
    parameter integer rfmode = 1 from [1:1];

