//******************************************************************************
// sg13g2_moscap PSP103VA paramsets
// Ported from `ngspice/models/sg13g2_moscap_parm.lib` to Verilog-A
// NMOS paramset: `paramsets/sg13g2_moscap_nmos.va`
// PMOS paramset: `paramsets/sg13g2_moscap_nmos.va`
// (c) Lukas Deutz 2026

// compiler directive
`pragma modelgen nogen-module
// include generic model
`include "psp103.va"
// include specialized paramsets
`include "paramsets/sg13g2_moscap_nmos.va"
`include "paramsets/sg13g2_moscap_pmos.va"
