load mgsim

verilog
`include ../../../models/corners/cornerHBT.va
`include ./tb_ac_hbt_13g2.va


hbt_wcs corner_hbt();
tb_ac_hbt_13g2 tb(vc, vb);

// run ac
// Start with tight voltage limits to help convergence.
options vmax = 0.1 vmin = -0.1
dc
options numdgt = 9
print ac v(vc) v(vb)
store ac v(vc) v(vb)
ac dec 10 1e4 1e8 basic
status notime
