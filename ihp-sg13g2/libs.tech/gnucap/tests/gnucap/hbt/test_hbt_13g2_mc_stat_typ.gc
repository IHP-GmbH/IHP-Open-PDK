// load modelgen
load mgsim
// load custom gnucap plugins
load ../../../plugins/gnucap
load ../../../plugins/models/

verilog
`include ../../../models/corners/cornerHBT.va
`include ./tb_dc_mc_hbt_13g2.va

hbt_typ_stat corner_hbt();
tb_mc_hbt_13g2 #(.mm_ok(0)) tb();

// measure collector current through VCE; VBIC does not declare Ic as an outputvar.
print dc i(tb.vce)
store dc i(tb.vce)
// Start with tight voltage limits to help convergence.
options vmax = 0.1 vmin = -0.1
dc $seed 1 1000 1 basic
measure ic_mean = sample_mean("i(tb.vce)")
measure ic_std = sample_std("i(tb.vce)")
status notime
