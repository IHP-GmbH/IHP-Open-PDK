if TABLES.include?('vian') || BEOL
  #===============================================
  #------------------ 5.20. Vian -----------------
  #===============================================

  logger.info('Starting 5.20. Vian table')

  # Vian and metal lists
  vias_lay   = [via2_drw, via3_drw, via4_drw]
  metals_lay = [metal2_drw, metal3_drw, metal4_drw]
  via_start_index = 2

  vias_lay.zip(metals_lay).each_with_index do |(via_lay, metal_lay), index|
    via_no = via_start_index + index

    # Vian derivations
    vian_nseal = via_lay.not(edgeseal_drw)

    # Rule Vn.a: Min. and max. Vian width is 0.19µm
    logger.info("Executing rule V#{via_no}.a")
    vn_a_value = drc_rules['Vn_a'].to_f
    vn_a_l1 = vian_nseal.without_bbox_min(vn_a_value.um)
    vn_a_l2 = vian_nseal.without_bbox_max(vn_a_value.um)
    vn_a_l = vn_a_l1.join(vn_a_l2)
    vn_a_l.output("V#{via_no}.a", "5.20. V#{via_no}.a : Min. and max. Via#{via_no} width: #{vn_a_value} µm")
    vn_a_l1.forget
    vn_a_l2.forget
    vn_a_l.forget

    # Rule Vn.b: Min. Vian space is 0.22µm
    logger.info("Executing rule V#{via_no}.b")
    vn_b_value = drc_rules['Vn_b'].to_f
    vn_b_l = vian_nseal.space(vn_b_value.um, euclidian)
    vn_b_l.output("V#{via_no}.b", "5.20. V#{via_no}.b : Min. Via#{via_no} space: #{vn_b_value} µm")
    vn_b_l.forget

    next if PRECHECK_DRC

    # Rule Vn.b1: Min. Via(n) space in an array of more than 3 rows and more than
    # 3 columns is 0.29 um (required in one direction only; the other direction
    # must be at least Vn.b)
    logger.info("Executing rule V#{via_no}.b1")
    vn_b1_value = drc_rules['Vn_b1'].to_f
    vn_b1_nr = drc_rules['Vn_b1_nr'].to_i
    vn_a_sz = drc_rules['Vn_a'].to_f
    vn_b_arr = drc_rules['Vn_b'].to_f
    # Detect arrays: merge vias with half-b1 sizing, then filter by array size
    vnb1_via_noseal = via_lay.ext_not(edgeseal_drw)
    vnb1_merged = vnb1_via_noseal.sized((vn_b1_value * 0.5).um, acute_limit).sized(-(vn_b1_value * 0.5).um, acute_limit)
    vnb1_array_size = (vn_b1_nr + 1) * vn_a_sz + vn_b1_nr * vn_b_arr - 0.05
    vnb1_arrays = vnb1_merged.sized(-(vnb1_array_size * 0.5).um, acute_limit).sized((vnb1_array_size * 0.5).um, acute_limit)
    vnb1_in = vnb1_via_noseal.inside(vnb1_arrays)
    vnb1_big = vnb1_in.sized(0.143.um, acute_limit).sized(-0.143.um, acute_limit)
    vnb1_err1 = vnb1_big.ext_not(vnb1_in)
    vnb1_err2 = vnb1_err1.ext_not(vnb1_err1.ext_rectangles)
    vnb1_l = vnb1_err2.ext_or(vnb1_in.ext_touching(vnb1_err2))
    vnb1_l.output("V#{via_no}.b1",
                  "5.20. V#{via_no}.b1: Min. Via#{via_no} space in array > #{vn_b1_nr}x#{vn_b1_nr}: #{vn_b1_value} µm")
    vnb1_via_noseal.forget
    vnb1_merged.forget
    vnb1_arrays.forget
    vnb1_in.forget
    vnb1_big.forget
    vnb1_err1.forget
    vnb1_err2.forget
    vnb1_l.forget

    # Rule Vn.c: Min. metal enclosure of Via is 0.005µm
    logger.info("Executing rule V#{via_no}.c")
    vn_c_value = drc_rules['Vn_c'].to_f
    vn_c_l = via_lay.enclosed(metal_lay, vn_c_value.um, euclidian)
    vn_c_l.output("V#{via_no}.c",
                 "5.20. V#{via_no}.c : Min. Metal#{via_no} enclosure of Via#{via_no} is #{vn_c_value} µm")
    vn_c_l.forget

    # Rule Vn.c1: Min. Metal(n) endcap enclosure of Via(n) is 0.05 um
    # For Via(n) at Metal(n) corners at least one side must be treated as an endcap
    # and for the other sides rule Vn.c can be applied.
    logger.info("Executing rule V#{via_no}.c1")
    vn_c1_value = drc_rules['Vn_c1'].to_f
    vn_c_value_c1 = drc_rules['Vn_c'].to_f
    vn_a_value_c1 = drc_rules['Vn_a'].to_f
    vn_c1_via = via_lay.ext_not(sram_drw).ext_outside(edgeseal_drw)
    vn_c1_metal = metal_lay.ext_outside(edgeseal_drw)
    vn_c1_sq = vn_c1_via.ext_rectangles(false, false, [['==', vn_a_value_c1.um]], [['==', vn_a_value_c1.um]], nil)
    vn_c1_l = vn_c1_sq.drc(if_any(
        !rectangles,
        primary - secondary(vn_c1_metal),
        (if_any(enclosed(vn_c1_metal) < vn_c_value_c1.um,
                enclosed(vn_c1_metal, projection, whole_edges, one_side_allowed,
                         two_opposite_sides_allowed) < vn_c1_value.um))))
    vn_c1_l.output("V#{via_no}.c1",
                  "5.20. V#{via_no}.c1: Min. Metal#{via_no} endcap enclosure of Via#{via_no}: #{vn_c1_value} µm")
    vn_c1_via.forget
    vn_c1_metal.forget
    vn_c1_sq.forget
    vn_c1_l.forget
  end
end

