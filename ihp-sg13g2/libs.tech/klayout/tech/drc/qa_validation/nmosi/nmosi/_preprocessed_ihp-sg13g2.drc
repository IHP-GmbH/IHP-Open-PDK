  offgrid_l.forget

  logger.info('Executing rule OffGrid.ThickGateOx')
  offgrid_l = thickgateox_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.ThickGateOx', 'ThickGateOx is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Activ_filler')
  offgrid_l = activ_filler.ongrid(grid.um)
  offgrid_l.output('OffGrid.Activ_filler', 'Activ_filler is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.GatPoly_filler')
  offgrid_l = gatpoly_filler.ongrid(grid.um)
  offgrid_l.output('OffGrid.GatPoly_filler', 'GatPoly_filler is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.GatPoly')
  offgrid_l = gatpoly_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.GatPoly', 'GatPoly is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.pSD')
  offgrid_l = psd_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.pSD', 'pSD is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.nSD')
  offgrid_l = nsd_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.nSD', 'nSD is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.nSD_block')
  offgrid_l = nsd_block.ongrid(grid.um)
  offgrid_l.output('OffGrid.nSD_block', 'nSD_block is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.EXTBlock')
  offgrid_l = extblock_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.EXTBlock', 'EXTBlock is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.SalBlock')
  offgrid_l = salblock_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.SalBlock', 'SalBlock is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Cont')
  offgrid_l = cont_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.Cont', 'Cont is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Activ_nofill')
  offgrid_l = activ_nofill.ongrid(grid.um)
  offgrid_l.output('OffGrid.Activ_nofill', 'Activ_nofill is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.GatPoly_nofill')
  offgrid_l = gatpoly_nofill.ongrid(grid.um)
  offgrid_l.output('OffGrid.GatPoly_nofill', 'GatPoly_nofill is off-grid')
  offgrid_l.forget

  # BEOL layers

  logger.info('Executing rule OffGrid.Metal1')
  offgrid_l = metal1_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal1', 'Metal1 is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Via1')
  offgrid_l = via1_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.Via1', 'Via1 is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Metal2')
  offgrid_l = metal2_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal2', 'Metal2 is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Via2')
  offgrid_l = via2_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.Via2', 'Via2 is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Metal3')
  offgrid_l = metal3_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal3', 'Metal3 is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Via3')
  offgrid_l = via3_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.Via3', 'Via3 is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Metal4')
  offgrid_l = metal4_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal4', 'Metal4 is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Via4')
  offgrid_l = via4_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.Via4', 'Via4 is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Metal5')
  offgrid_l = metal5_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal5', 'Metal5 is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.MIM')
  offgrid_l = mim_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.MIM', 'MIM is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Vmim')
  offgrid_l = vmim_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.Vmim', 'Vmim is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.TopVia1')
  offgrid_l = topvia1_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.TopVia1', 'TopVia1 is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.TopMetal1')
  offgrid_l = topmetal1_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.TopMetal1', 'TopMetal1 is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.TopVia2')
  offgrid_l = topvia2_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.TopVia2', 'TopVia2 is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.TopMetal2')
  offgrid_l = topmetal2_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.TopMetal2', 'TopMetal2 is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Passiv')
  offgrid_l = passiv_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.Passiv', 'Passiv is off-grid')
  offgrid_l.forget

  # Filler layers

  logger.info('Executing rule OffGrid.Metal1_filler')
  offgrid_l = metal1_filler.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal1_filler', 'Metal1_filler is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Metal2_filler')
  offgrid_l = metal2_filler.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal2_filler', 'Metal2_filler is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Metal3_filler')
  offgrid_l = metal3_filler.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal3_filler', 'Metal3_filler is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Metal4_filler')
  offgrid_l = metal4_filler.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal4_filler', 'Metal4_filler is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Metal5_filler')
  offgrid_l = metal5_filler.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal5_filler', 'Metal5_filler is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.TopMetal1_filler')
  offgrid_l = topmetal1_filler.ongrid(grid.um)
  offgrid_l.output('OffGrid.TopMetal1_filler', 'TopMetal1_filler is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.TopMetal2_filler')
  offgrid_l = topmetal2_filler.ongrid(grid.um)
  offgrid_l.output('OffGrid.TopMetal2_filler', 'TopMetal2_filler is off-grid')
  offgrid_l.forget

  # NoFill layers

  logger.info('Executing rule OffGrid.Metal1_nofill')
  offgrid_l = metal1_nofill.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal1_nofill', 'Metal1_nofill is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Metal2_nofill')
  offgrid_l = metal2_nofill.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal2_nofill', 'Metal2_nofill is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Metal3_nofill')
  offgrid_l = metal3_nofill.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal3_nofill', 'Metal3_nofill is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Metal4_nofill')
  offgrid_l = metal4_nofill.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal4_nofill', 'Metal4_nofill is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Metal5_nofill')
  offgrid_l = metal5_nofill.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal5_nofill', 'Metal5_nofill is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.TopMetal1_nofill')
  offgrid_l = topmetal1_nofill.ongrid(grid.um)
  offgrid_l.output('OffGrid.TopMetal1_nofill', 'TopMetal1_nofill is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.TopMetal2_nofill')
