if TABLES.include?('forbidden') || FORBIDDEN
  #================================================
  #---------------- 3.2. Forbidden ----------------
  #================================================

  logger.info('Starting 3.2. FORBIDDEN table')

  forb_lays = {
    'biwind' => biwind_drw,
    'pemwind' => pemwind_drw,
    'baspoly' => baspoly_drw,
    'deepco' => deepco_drw,
    'pempoly' => pempoly_drw,
    'empoly' => empoly_drw,
