if TABLES.include?('nbulay') || FEOL
  #================================================
  #------------------ 5.3 nBuLay ------------------
  #================================================

  logger.info('Starting 5.3 nBuLay table')

  unless PRECHECK_DRC
    # Rule NBL.a: Min. nBuLay width is 1.00 um
    logger.info('Executing rule NBL.a')
    nbl_a_value = drc_rules['NBL_a'].to_f
    nbl_a_l = nbuLay_gen_nbulay.width(nbl_a_value.um, euclidian)
    nbl_a_l.output('NBL.a', "5.3.NBL.a : Min. nBuLay width is #{nbl_a_value} um")
    nbl_a_l.forget

    # Rule NBLB.a: Min. nBuLay:block width is 1.50 um
    logger.info('Executing rule NBLB.a')
    nblb_a_value = drc_rules['NBLB_a'].to_f
    nblb_a_l = nbulay_block.width(nblb_a_value.um, euclidian)
    nblb_a_l.output('NBLB.a', "5.3.NBLB.a : Min. nBuLay:block width is #{nblb_a_value} um")
    nblb_a_l.forget

    # Rule NBLB.b: Min. nBuLay:block space or notch is 1.00 um
    logger.info('Executing rule NBLB.b')
    nblb_b_value = drc_rules['NBLB_b'].to_f
    nblb_b_l = nbulay_block.space(nblb_b_value.um, euclidian)
    nblb_b_l.output('NBLB.b', "5.3.NBLB.b : Min. nBuLay:block space or notch is #{nblb_b_value} um")
    nblb_b_l.forget

    # Rule NBLB.c: Min. nBuLay enclosure of nBuLay:block is 1.00 um
    logger.info('Executing rule NBLB.c')
    nblb_c_value = drc_rules['NBLB_c'].to_f
    nblb_c_l = nbulay_block.ext_enclosed(nbulay_drw, nblb_c_value.um,
                                        consider_touch_points: false,
                                        polygon_output: true)
    nblb_c_l.output('NBLB.c', "5.3.NBLB.c : Min. nBuLay enclosure of nBuLay:block is #{nblb_c_value} um")
    nblb_c_l.forget

    # Rule NBLB.d: Min. nBuLay:block space to unrelated nBuLay is 1.50 um
    logger.info('Executing rule NBLB.d')
    nblb_d_value = drc_rules['NBLB_d'].to_f
    nblb_d_l = nbulay_block.sep(nbulay_drw, nblb_d_value.um, euclidian)
    nblb_d_l.output('NBLB.d', "5.3.NBLB.d : Min. nBuLay:block space to unrelated nBuLay is #{nblb_d_value} um")
    nblb_d_l.forget
  end

  if !PRECHECK_DRC && CONNECTIVITY_RULES
    # nBulay connectivity derivations
    nbl_nets = nbuLay_gen_nbulay.nets
    nactiv_nets = nactiv.nets
    ptap_nets = ptap.nets

    # Rule NBL.b: Min. nBuLay space or notch (same net) is 1.50 um
    logger.info('Executing rule NBL.b')
    nbl_b_value = drc_rules['NBL_b'].to_f
    nbl_b = nbl_nets.space(nbl_b_value.um, props_eq)
    nbl_b.output('NBL.b', "5.3.NBL.b : Min. nBuLay space or notch (same net) is #{nbl_b_value} um")
    nbl_b.forget

    # Rule NBL.c: Min. PWell width between nBuLay regions (different net) is 3.20 um
    logger.info('Executing rule NBL.c')
    nbl_c_value = drc_rules['NBL_c'].to_f
    nbl_c_pwl = pwell_block.interacting(nbuLay_gen_nbulay)
    nbl_c_l1 = nbl_nets.space(nbl_c_value.um, props_ne).polygons
    nbl_c_l2 = nbl_c_pwl.sep(nbuLay_gen_nbulay, nbl_c_value.um, euclidian, without_touching_edges).polygons
    nbl_c = nbl_c_l1.join(nbl_c_l2).and(pwell)
    nbl_c.output('NBL.c', "5.3.NBL.c : Min. PWell width between nBuLay regions (different net) is #{nbl_c_value} um")
    nbl_c_l1.forget
    nbl_c_l2.forget
    nbl_c.forget
    nbl_c_pwl.forget

    # Rule NBL.d: Min. PWell width between nBuLay and NWell (different net) is 2.20 um
    logger.info('Executing rule NBL.d')
    nbl_d_value = drc_rules['NBL_d'].to_f
    nbl_d_pwl = pwell_block.interacting(nwell_drw)
    nbl_d_l1 = nbl_nets.sep(nwell_nets, nbl_d_value.um, props_ne).polygons
    nbl_d_l2 = nbl_d_pwl.sep(nbuLay_gen_nbulay, nbl_d_value.um, euclidian, without_touching_edges).polygons
    nbl_d = nbl_d_l1.join(nbl_d_l2).and(pwell)
    nbl_d.output('NBL.d',
                  "5.3.NBL.d : Min. PWell width between nBuLay and NWell (different net) is #{nbl_d_value} um")
    nbl_d_l1.forget
    nbl_d_l2.forget
    nbl_d.forget
    nbl_d_pwl.forget

    # Rule NBL.e: Min. nBuLay space to unrelated N+Activ is 1.00 um
    logger.info('Executing rule NBL.e')
    nbl_e_value = drc_rules['NBL_e'].to_f
    nbl_e = nbl_nets.sep(nactiv_nets, nbl_e_value.um, props_ne)
    nbl_e.output('NBL.e', "5.3.NBL.e : Min. nBuLay space to unrelated N+Activ is #{nbl_e_value} um")
    nbl_e.forget

    # Rule NBL.f: Min. nBuLay space to unrelated P+Activ is 0.50 um
    logger.info('Executing rule NBL.f')
    nbl_f_value = drc_rules['NBL_f'].to_f
    nbl_f = nbl_nets.sep(ptap_nets, nbl_f_value.um, props_ne).polygons.not(svaricap)
    nbl_f.output('NBL.f', "5.3.NBL.f : Min. nBuLay space to unrelated P+Activ is #{nbl_f_value} um")
    nbl_f.forget
  end
end

