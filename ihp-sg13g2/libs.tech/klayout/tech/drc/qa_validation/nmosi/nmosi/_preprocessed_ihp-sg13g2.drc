if TABLES.include?('offgrid') || OFFGRID
  #==============================================
  #-------------- Off-Grid Checks ---------------
  #==============================================

  logger.info('Starting Off-Grid checks (5 nm manufacturing grid)')

  grid = drc_rules['grid'].to_f

  # FEOL layers

  logger.info('Executing rule OffGrid.NWell')
  offgrid_l = nwell_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.NWell', 'NWell is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.PWell')
  offgrid_l = pwell_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.PWell', 'PWell is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.PWell_block')
  offgrid_l = pwell_block.ongrid(grid.um)
  offgrid_l.output('OffGrid.PWell_block', 'PWell_block is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.nBuLay')
  offgrid_l = nbulay_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.nBuLay', 'nBuLay is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.nBuLay_block')
  offgrid_l = nbulay_block.ongrid(grid.um)
  offgrid_l.output('OffGrid.nBuLay_block', 'nBuLay_block is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Activ')
  offgrid_l = activ_drw.ongrid(grid.um)
