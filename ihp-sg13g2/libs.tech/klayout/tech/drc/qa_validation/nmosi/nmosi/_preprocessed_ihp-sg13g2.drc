  offgrid_l.output('OffGrid.Metal3_slit', 'Metal3_slit is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.Metal4_slit')
  offgrid_l = metal4_slit.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal4_slit', 'Metal4_slit is off-grid')
