if TABLES.include?('topmetal1filler') || BEOL
  #================================================
  #----------------- 5.23 TopMetal1:filler --------
  #================================================

  logger.info('Starting 5.23 TopMetal1:filler table')

  # TopMetal1:filler derivations

  # Enable tiling mode for large designs
  if en_tiles
    # Run mode
    setup_run_mode('tiling')
    logger.info('Tiling mode is enabled for TopMetal1:filler table.')
  end

  # Rule TM1Fil.c : Min. TopMetal1:filler space to TopMetal1 is 3 um
  logger.info('Executing rule TM1Fil.c')
  tm1fil_c_value = drc_rules['TM1Fil_c'].to_f
  tm1fil_c_l = topmetal1_drw.sep(topmetal1_filler, tm1fil_c_value.um, euclidian)
  tm1fil_c_l.output('TM1Fil.c', "5.23. TM1Fil.c : Min. TopMetal1:filler space to TopMetal1 is #{tm1fil_c_value} um")
  tm1fil_c_l.forget

  unless PRECHECK_DRC
    # Rule TM1Fil.a : Min. TopMetal1:filler width is 5.00 um
    logger.info('Executing rule TM1Fil.a')
    tm1fil_a_value = drc_rules['TM1Fil_a'].to_f
    tm1fil_a_l = topmetal1_filler.width(tm1fil_a_value.um, euclidian)
    tm1fil_a_l.output('TM1Fil.a', "5.23. TM1Fil.a : Min. TopMetal1:filler width is #{tm1fil_a_value} um")
    tm1fil_a_l.forget

    # Rule TM1Fil.a1 : Max. TopMetal1:filler width is 10.00 um
    logger.info('Executing rule TM1Fil.a1')
    tm1fil_a1_value = drc_rules['TM1Fil_a1'].to_f
    tm1fil_a1_l = topmetal1_filler.with_bbox_max(tm1fil_a1_value.um + 0.001.um, nil)
    tm1fil_a1_l.output('TM1Fil.a1', "5.23. TM1Fil.a1 : Max. TopMetal1:filler width is #{tm1fil_a1_value} um")
    tm1fil_a1_l.forget

    # Rule TM1Fil.b : Min. TopMetal1:filler space is 3.00 um
    logger.info('Executing rule TM1Fil.b')
    tm1fil_b_value = drc_rules['TM1Fil_b'].to_f
    tm1fil_b_l = topmetal1_filler.space(tm1fil_b_value.um, euclidian)
    tm1fil_b_l.output('TM1Fil.b', "5.23. TM1Fil.b : Min. TopMetal1:filler space is #{tm1fil_b_value} um")
    tm1fil_b_l.forget

    # Rule TM1Fil.d : Min. TopMetal1:filler space to TRANS is 4.90 um
    logger.info('Executing rule TM1Fil.d')
    tm1fil_d_value = drc_rules['TM1Fil_d'].to_f
    tm1fil_d_l = trans_drw.sep(topmetal1_filler, tm1fil_d_value.um, euclidian)
    tm1fil_d_l.output('TM1Fil.d', "5.23. TM1Fil.d : Min. TopMetal1:filler space to TRANS is #{tm1fil_d_value} um")
    tm1fil_d_l.forget
  end

  if en_tiles
    # Run mode
    setup_run_mode($run_mode)
    logger.info("#{$run_mode} mode is enabled after TopMetal1:filler table.")
  end
end

