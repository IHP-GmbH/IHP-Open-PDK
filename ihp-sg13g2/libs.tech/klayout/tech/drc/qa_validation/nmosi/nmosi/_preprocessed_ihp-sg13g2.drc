  offgrid_l.forget

  logger.info('Executing rule OffGrid.IND')
  offgrid_l = ind_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.IND', 'IND is off-grid')
  offgrid_l.forget

  logger.info('Executing rule OffGrid.RES')
  offgrid_l = res_drw.ongrid(grid.um)
  offgrid_l.output('OffGrid.RES', 'RES is off-grid')
