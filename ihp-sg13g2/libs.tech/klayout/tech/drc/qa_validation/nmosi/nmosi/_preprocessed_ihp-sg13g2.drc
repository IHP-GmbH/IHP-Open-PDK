  offgrid_l.forget

  # Slit layers

  logger.info('Executing rule OffGrid.Metal1_slit')
  offgrid_l = metal1_slit.ongrid(grid.um)
  offgrid_l.output('OffGrid.Metal1_slit', 'Metal1_slit is off-grid')
