if TABLES.include?('mim') || BEOL
  #================================================
  #--------------------- 6.11 MIM -----------------
  #================================================

  logger.info('Starting 6.11 MIM table')

  # MIM derivations

  unless PRECHECK_DRC
    # Rule MIM.a: Min. MIM width is 1.14 um
    logger.info('Executing rule MIM.a')
    mim_a_value = drc_rules['Mim_a'].to_f
    mim_a = mim_drw.width(mim_a_value.um, euclidian)
    mim_a.output('MIM.a', "6.11. MIM.a : Min. MIM width is #{mim_a_value} um")
    mim_a.forget

    # Rule MIM.b: Min. MIM space is 0.60 um
    logger.info('Executing rule MIM.b')
    mim_b_value = drc_rules['Mim_b'].to_f
    mim_b = mim_drw.space(mim_b_value.um, euclidian)
    mim_b.output('MIM.b', "6.11. MIM.b : Min. MIM space is #{mim_b_value} um")
    mim_b.forget

    # Rule MIM.c: Min. Metal5 enclosure of MIM is 0.60 um
    logger.info('Executing rule MIM.c')
    mim_c_value = drc_rules['Mim_c'].to_f
    mim_c_p1 = mim_drw.enclosed(metal5_drw, mim_c_value.um, euclidian).polygons
    mim_c_p2 = mim_drw.not(metal5_drw)
    mim_c = mim_c_p1.join(mim_c_p2)
    mim_c.output('MIM.c', "6.11. MIM.c : Min. Metal5 enclosure of MIM is #{mim_c_value} um")
    mim_c_p1.forget
    mim_c_p2.forget
    mim_c.forget

    # Rule MIM.d: MIM enclosure of TopVia1 is 0.36 um
    logger.info('Executing rule MIM.d')
    mim_d_value = drc_rules['Mim_d'].to_f
    mim_d = topvia1_drw.enclosed(mim_drw, mim_d_value.um, euclidian)
    mim_d.output('MIM.d', "6.11. MIM.d : Min. MIM enclosure of TopVia1 is #{mim_d_value} um")
    mim_d.forget

    # Rule MIM.e: Min. TopMetal1 space to MIM is 0.60 um
    logger.info('Executing rule MIM.e')
    mim_e_value = drc_rules['Mim_e'].to_f
    mim_e = topmetal1_drw.sep(mim_drw, mim_e_value.um, euclidian)
    mim_e.output('MIM.e', "6.11. MIM.e : Min. TopMetal1 space to MIM is #{mim_e_value} um")
    mim_e.forget

    # Rule MIM.f: Min. MIM area per MIM device (um2) is 1.30 um2
    logger.info('Executing rule MIM.f')
    mim_f_value = drc_rules['Mim_f'].to_f
    mim_f = mim_drw.with_area(nil, mim_f_value.um)
    mim_f.output('MIM.f', "6.11. MIM.f : Min. MIM area per MIM device is #{mim_f_value} um2")
    mim_f.forget

    # Rule MIM.g: Max. MIM area per MIM device (um2) is 5625.00 um2
    logger.info('Executing rule MIM.g')
    mim_g_value = drc_rules['Mim_g'].to_f
    mim_g = mim_drw.ext_with_area([[">", mim_g_value.um2]])
    mim_g.output('MIM.g', "6.11. MIM.g : Max. MIM area per MIM device is #{mim_g_value} um2")
    mim_g.forget

    if RECOMMENDED
      # Rule MIM.gR: Max. recommended total MIM area per chip (um2) is 174800.00 um2
      logger.info('Executing rule MIM.gR')
      mim_gr_value = drc_rules['Mim_gR'].to_f
      mim_total_area = mim_drw.area
      if mim_total_area > mim_gr_value.um
        mim_drw.output('MIM.gR', "6.11. MIM.gR : Max. recommended total MIM area per chip (um2) is #{mim_gr_value} um2, Total used MIM area is #{mim_total_area} um2")
      end
    end

    # Rule MIM.h: TopVia1 must be over MIM
    logger.info('Executing rule MIM.h')
    mim_h_l1 = mim_drw.interacting(topvia1_drw.join(vmim_drw))
    mim_h = mim_drw.not(mim_h_l1)
    mim_h.output('MIM.h', '6.11. MIM.h : TopVia1 must be over MIM')
    mim_h_l1.forget
    mim_h.forget
  end
end

# frozen_string_literal: true

#=========================================================================================
# Copyright 2025 IHP PDK Authors
#
# Licensed under the Apache License, Version 2.0 (the "License");
# you may not use this file except in compliance with the License.
# You may obtain a copy of the License at
#
#     https://www.apache.org/licenses/LICENSE-2.0
#
# Unless required by applicable law or agreed to in writing, software
# distributed under the License is distributed on an "AS IS" BASIS,
# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
# See the License for the specific language governing permissions and
# limitations under the License.
#=========================================================================================

if TABLES.include?('metalslits') || BEOL
  #================================================
  #----------------- 7.3 Metal Slits --------------
  #================================================

  logger.info('Starting 7.3 Metal Slits table')

  # Metal slits derivations

  # Pad derivation (dfpad shapes overlapping Passiv)
  pad_slt = dfpad_drw.not_outside(passiv_drw)

  # Slit layers (raw from GDS)
  metals_slit_lays = [metal1_slit, metal2_slit, metal3_slit, metal4_slit, metal5_slit,
                      topmetal1_slit, topmetal2_slit]

  # Slit-not-pad layers
  metals_slit_not_pad = metals_slit_lays.map { |s| s.ext_not(pad_slt) }

  # Metal drawing layers
  metals_drw = [metal1_drw, metal2_drw, metal3_drw, metal4_drw, metal5_drw,
                topmetal1_drw, topmetal2_drw]

  # Recognition + dfpad exclusion regions
  dfpad_all = dfpad_drw.ext_or(dfpad_pillar, dfpad_sbump)
  recog_or_dfpad_all = recog_drw.ext_or(dfpad_all)
  recog_or_mim_or_dfpad_all = mim_drw.ext_or(recog_drw, dfpad_all)

  # sltc layers (metal excluding recognition/dfpad/MIM regions, for Slt.c check)
  # M1-M4, TM2 use recog_or_dfpad_all; M5, TM1 also exclude MIM
  sltc_lays = [
    metal1_drw.ext_not(recog_or_dfpad_all),        # M1
    metal2_drw.ext_not(recog_or_dfpad_all),        # M2
    metal3_drw.ext_not(recog_or_dfpad_all),        # M3
    metal4_drw.ext_not(recog_or_dfpad_all),        # M4
    metal5_drw.ext_not(recog_or_mim_or_dfpad_all), # M5
    topmetal1_drw.ext_not(recog_or_mim_or_dfpad_all), # TM1
    topmetal2_drw.ext_not(recog_or_dfpad_all)      # TM2
  ]

  metals_abbrev = %w[M1 M2 M3 M4 M5 TM1 TM2]

  # Via layers for h-rules: each metal's adjacent vias below and above
  # M1: Cont, Via1 | M2: Via1, Via2 | M3: Via2, Via3 | M4: Via3, Via4
  # M5: Via4, TopVia1 | TM1: TopVia1 (single) | TM2: TopVia2 (single)
  vias_below = [cont_drw, via1_drw, via2_drw, via3_drw, via4_drw, topvia1_drw, topvia2_drw]
  vias_above = [via1_drw, via2_drw, via3_drw, via4_drw, topvia1_drw, nil, nil]

  # JSON parameter values
  slt_a_value = drc_rules['Slt_a'].to_f
  slt_b_value = drc_rules['Slt_b'].to_f
  slt_c_value = drc_rules['Slt_c'].to_f
  slt_f_value = drc_rules['Slt_f'].to_f
  slt_g_value = drc_rules['Slt_g'].to_f
  slt_h1_value = drc_rules['Slt_h1'].to_f
  slt_h2_value = drc_rules['Slt_h2'].to_f
  slt_h3_value = drc_rules['Slt_h3'].to_f

  # Slt.c sizing parameters (max metal width without slit = 30 um)
  # Derived from maximal: sized(-3), sized(-12), sized(+15) => checks for 30um width
  slt_c_half = (slt_c_value / 2.0)

  unless PRECHECK_DRC

    # ---- Rules templated per metal layer (M1 through TM2) ----
    metals_slit_lays.zip(metals_slit_not_pad, metals_drw, sltc_lays, metals_abbrev,
                         vias_below, vias_above).each_with_index do |(met_slit, met_slit_np, met_drw,
                                                                       sltc, met_abbrev,
                                                                       via_below, via_above), idx|

      # Rule Slt.a: Min. slit width
      logger.info("Executing rule Slt.a.#{met_abbrev}")
      slt_a_l = met_slit_np.ext_width(slt_a_value.um)
      slt_a_l.output("Slt.a.#{met_abbrev}",
                     "7.3. Slt.a.#{met_abbrev} : Min. #{met_abbrev}:slit width is #{slt_a_value} um")
      slt_a_l.forget

      # Rule Slt.b: Max. slit width
      logger.info("Executing rule Slt.b.#{met_abbrev}")
      slt_b_tmp = met_slit_np.ext_with_length([['>', slt_b_value.um]])
      slt_b_l = met_slit.ext_with_coincident_edges(slt_b_tmp)
      slt_b_l.output("Slt.b.#{met_abbrev}",
                     "7.3. Slt.b.#{met_abbrev} : Max. #{met_abbrev}:slit width is #{slt_b_value} um")
      slt_b_l.forget
      slt_b_tmp.forget

      # Rule Slt.c: Max. metal width without requiring a slit
      logger.info("Executing rule Slt.c.#{met_abbrev}")
      met_no_slit = sltc.ext_not(met_slit)
      slt_c_l1 = met_no_slit.sized(-3.um, acute_limit).sized(-12.um, acute_limit)
      slt_c_l = slt_c_l1.sized(15.um, acute_limit)
      slt_c_l.output("Slt.c.#{met_abbrev}",
                     "7.3. Slt.c.#{met_abbrev} : Max. #{met_abbrev} width without requiring a slit is #{slt_c_value} um")
      slt_c_l.forget
      slt_c_l1.forget
      met_no_slit.forget

      # Rule Slt.e: No slits required on pads
      logger.info("Executing rule Slt.e.#{met_abbrev}")
      slt_e_l = met_slit.ext_and(pad_slt)
      slt_e_l.output("Slt.e.#{met_abbrev}",
                     "7.3. Slt.e.#{met_abbrev} : No slits required on pads")
      slt_e_l.forget

      # Rule Slt.f: Min. metal enclosure of slit
      logger.info("Executing rule Slt.f.#{met_abbrev}")
      slt_f_l = met_slit_np.ext_enclosed(met_drw, slt_f_value.um)
      slt_f_l.output("Slt.f.#{met_abbrev}",
                     "7.3. Slt.f.#{met_abbrev} : Min. #{met_abbrev} enclosure of #{met_abbrev}:slit is #{slt_f_value} um")
      slt_f_l.forget

      # Rule Slt.g: Min. slit space to MIM (only M5 and TM1)
      if met_abbrev == 'M5' || met_abbrev == 'TM1'
        logger.info("Executing rule Slt.g.#{met_abbrev}")
        # Complex Slt.g logic matching maximal deck:
        # 1. ext_separation for non-coincident edges
        slt_g_tmp1 = met_slit.ext_separation(mim_drw, slt_g_value.um,
                                              consider_intersecting_edges: false,
                                              consider_touch_points: false, polygon_output: true)
        # 2. Find MIM edges coincident with slit (outside edges only)
        slt_g_tmp2 = mim_drw.ext_coincident_edges(met_slit, outside: true, consider_touch_points: true)
        # 3. Find slit shapes that have coincident edges with step 2 result
        slt_g_tmp3 = met_slit.ext_with_coincident_edges(slt_g_tmp2)
        # 4. Combine separation errors + coincident edge shapes
        slt_g_tmp4 = slt_g_tmp1 + slt_g_tmp3
        # 5. Also include slit/MIM overlap regions
        slt_g_tmp5 = met_slit.ext_and(mim_drw)
        # 6. Final combined result
        slt_g_l = slt_g_tmp4 + slt_g_tmp5
        slt_g_l.output("Slt.g.#{met_abbrev}",
                       "7.3. Slt.g.#{met_abbrev} : Min. #{met_abbrev}:slit space to MIM is #{slt_g_value} um")
        slt_g_tmp1.forget
        slt_g_tmp2.forget
        slt_g_tmp3.forget
        slt_g_tmp4.forget
        slt_g_tmp5.forget
        slt_g_l.forget
      end

      # Rule Slt.h*: Min. slit space to vias
      # M1 uses Slt.h1 (unique rule name, space to Cont and Via1)
      # M2-M5 use Slt.h2.Mx (space to adjacent vias)
      # TM1 uses Slt.h3 (space to TopVia1, value = 1.00)
      # TM2 uses Slt.h4 (space to TopVia2, value = 1.00)
      case met_abbrev
      when 'M1'
        logger.info('Executing rule Slt.h1')
        [cont_drw, via1_drw].each do |via_lay|
          slt_h1_l = met_slit_np.ext_separation(via_lay, slt_h1_value.um)
          slt_h1_l.output('Slt.h1',
                         "7.3. Slt.h1 : Min. Metal1:slit space to Cont and Via1 is #{slt_h1_value} um")
          slt_h1_l.forget
        end
      when 'M2', 'M3', 'M4', 'M5'
        logger.info("Executing rule Slt.h2.#{met_abbrev}")
        [via_below, via_above].compact.each do |via_lay|
          slt_h2_l = met_slit_np.ext_separation(via_lay, slt_h2_value.um)
          slt_h2_l.output("Slt.h2.#{met_abbrev}",
                         "7.3. Slt.h2.#{met_abbrev} : Min. #{met_abbrev}:slit space to vias is #{slt_h2_value} um")
          slt_h2_l.forget
        end
      when 'TM1'
        logger.info('Executing rule Slt.h3')
        slt_h3_l = met_slit_np.ext_separation(topvia1_drw, slt_h3_value.um)
        slt_h3_l.output('Slt.h3',
                       "7.3. Slt.h3 : Min. TopMetal1:slit space to TopVia1 is #{slt_h3_value} um")
        slt_h3_l.forget
      when 'TM2'
        logger.info('Executing rule Slt.h4')
        # Slt.h4 uses same value as Slt.h3 (1.0 um) - hardcoded in maximal
        slt_h4_l = met_slit_np.ext_separation(topvia2_drw, 1.0.um)
        slt_h4_l.output('Slt.h4',
                       '7.3. Slt.h4 : Min. TopMetal2:slit space to TopVia2 is 1.00 um')
        slt_h4_l.forget
      end
    end

    # Rule Slt.e1: No slits required on MIM
    metals_slit_lays.zip(metals_abbrev).each do |met_slit_lay, met_abbrev|
      logger.info("Executing rule Slt.e1_#{met_abbrev}")
      slt_e1_l = mim_drw.and(met_slit_lay)
      slt_e1_l.output("Slt.e1_#{met_abbrev}", "7.3. Slt.e1_#{met_abbrev} : No #{met_abbrev}:slit required on MIM")
      slt_e1_l.forget
    end

    # Cleanup sltc layers
    sltc_lays.each(&:forget)
    metals_slit_not_pad.each(&:forget)
  end

  # Cleanup shared derivations
  pad_slt.forget
  dfpad_all.forget
  recog_or_dfpad_all.forget
  recog_or_mim_or_dfpad_all.forget
end

