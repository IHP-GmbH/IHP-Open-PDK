if TABLES.include?('via1') || BEOL
  #==============================================
  #----------------- 5.19. Via1 -----------------
  #==============================================

  logger.info('Starting 5.19. Via1 table')

  # Via1 derivations
  logger.info('Starting 5.19. Via1 table derivations')
  via1_nseal = via1_drw.not(edgeseal_drw)

  # Rule V1.a: Min. and max. Via1 width is 0.19µm
  logger.info('Executing rule V1.a')
  v1_a_value = drc_rules['V1_a'].to_f
  via1_nseal_a = via1_nseal.not(npn13g2l)
  v1a_l1 = via1_nseal_a.without_bbox_min(v1_a_value.um)
  v1a_l2 = via1_nseal_a.without_bbox_max(v1_a_value.um)
  v1a_l = v1a_l1.join(v1a_l2)
  v1a_l.output('V1.a', "5.19. V1.a : Min. and max. Via1 width: #{v1_a_value} µm")
  v1a_l1.forget
  v1a_l2.forget
  v1a_l.forget
  via1_nseal_a.forget

  # Rule V1.b: Min. Via1 space is 0.22µm
  logger.info('Executing rule V1.b')
  v1_b_value = drc_rules['V1_b'].to_f
  v1b_l = via1_nseal.space(v1_b_value.um, euclidian)
  v1b_l.output('V1.b', "5.19. V1.b : Min. Via1 space: #{v1_b_value} µm")
  v1b_l.forget

  unless PRECHECK_DRC
    # Rule V1.b1: Min. Via1 space in an array of more than 3 rows and more than
    # 3 columns is 0.29 um (required in one direction only; the other direction
    # must be at least V1.b)
    logger.info('Executing rule V1.b1')
    v1_b1_value = drc_rules['V1_b1'].to_f
    v1_b1_nr = drc_rules['V1_b1_nr'].to_i
    v1_a_value = drc_rules['V1_a'].to_f
    v1_b_value_arr = drc_rules['V1_b'].to_f
    # Detect arrays: merge vias with half-b1 sizing, then filter by array size
    v1b1_via_noseal = via1_drw.ext_not(edgeseal_drw)
    v1b1_merged = v1b1_via_noseal.sized((v1_b1_value * 0.5).um, acute_limit).sized(-(v1_b1_value * 0.5).um, acute_limit)
    v1b1_array_size = (v1_b1_nr + 1) * v1_a_value + v1_b1_nr * v1_b_value_arr - 0.05
    v1b1_arrays = v1b1_merged.sized(-(v1b1_array_size * 0.5).um, acute_limit).sized((v1b1_array_size * 0.5).um, acute_limit)
    v1b1_in = v1b1_via_noseal.inside(v1b1_arrays)
    v1b1_big = v1b1_in.sized(0.143.um, acute_limit).sized(-0.143.um, acute_limit)
    v1b1_err1 = v1b1_big.ext_not(v1b1_in)
    v1b1_err2 = v1b1_err1.ext_not(v1b1_err1.ext_rectangles)
    v1b1_l = v1b1_err2.ext_or(v1b1_in.ext_touching(v1b1_err2))
    v1b1_l.output('V1.b1',
                  "5.19. V1.b1: Min. Via1 space in array > #{v1_b1_nr}x#{v1_b1_nr}: #{v1_b1_value} µm")
    v1b1_via_noseal.forget
    v1b1_merged.forget
    v1b1_arrays.forget
    v1b1_in.forget
    v1b1_big.forget
    v1b1_err1.forget
    v1b1_err2.forget
    v1b1_l.forget

    # Rule V1.c: Min. Metal1 enclosure of Via1 is 0.01 um
    logger.info('Executing rule V1.c')
    v1_c_value = drc_rules['V1_c'].to_f
    v1_c_l = via1_nseal.enclosed(metal1_drw, v1_c_value.um, euclidian)
    v1_c_l.output('V1.c', "5.19.  V1.c Min. Metal1 enclosure of Via1 is #{v1_c_value} um")
    v1_c_l.forget

    # Rule V1.c1: Min. Metal1 endcap enclosure of Via1 is 0.05 um
    # For Via1 at Metal1 corners at least one side must be treated as an endcap
    # and for the other sides rule V1.c can be applied.
    logger.info('Executing rule V1.c1')
    v1_c1_value = drc_rules['V1_c1'].to_f
    v1_c_value = drc_rules['V1_c'].to_f
    v1_a_value_c1 = drc_rules['V1_a'].to_f
    v1_c1_via = via1_drw.ext_not(sram_drw).ext_outside(edgeseal_drw)
    v1_c1_metal = metal1_drw.ext_outside(edgeseal_drw)
    v1_c1_sq = v1_c1_via.ext_rectangles(false, false, [['==', v1_a_value_c1.um]], [['==', v1_a_value_c1.um]], nil)
    v1_c1_l = v1_c1_sq.drc(if_any(
        !rectangles,
        primary - secondary(v1_c1_metal),
        (if_any(enclosed(v1_c1_metal) < v1_c_value.um,
                enclosed(v1_c1_metal, projection, whole_edges, one_side_allowed,
                         two_opposite_sides_allowed) < v1_c1_value.um))))
    v1_c1_l.output('V1.c1',
                  "5.19. V1.c1: Min. Metal1 endcap enclosure of Via1: #{v1_c1_value} µm")
    v1_c1_via.forget
    v1_c1_metal.forget
    v1_c1_sq.forget
    v1_c1_l.forget
  end
end
