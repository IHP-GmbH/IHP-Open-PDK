if TABLES.include?('extblock') || FEOL
  #==============================================
  #------------- 5.13. EXTBlock ----------------
  #==============================================

  logger.info('Starting 5.13. EXTBlock table')

  # Rule EXTB.a: Min. EXTBlock width is 0.31 um
  logger.info('Executing rule EXTB.a')
  extb_a_value = drc_rules['EXTB_a'].to_f
  extb_a_l = extblock_drw.width(extb_a_value.um, euclidian)
  extb_a_l.output('EXTB.a', "5.13. EXTB.a : Min. EXTBlock width: #{extb_a_value} um")
  extb_a_l.forget

  # Rule EXTB.b: Min. EXTBlock space or notch is 0.31 um
  logger.info('Executing rule EXTB.b')
  extb_b_value = drc_rules['EXTB_b'].to_f
  extb_b_l = extblock_drw.space(extb_b_value.um, euclidian)
  extb_b_l.output('EXTB.b', "5.13. EXTB.b : Min. EXTBlock space or notch: #{extb_b_value} um")
  extb_b_l.forget

  unless PRECHECK_DRC
    # Rule EXTB.c: Min. EXTBlock space to pSD is 0.31 um
    logger.info('Executing rule EXTB.c')
    extb_c_value = drc_rules['EXTB_c'].to_f
    extb_c_l = extblock_drw.separation(psd_drw, extb_c_value.um, euclidian)
    extb_c_l.output('EXTB.c', "5.13. EXTB.c : Min. EXTBlock space to pSD: #{extb_c_value} um")
    extb_c_l.forget
  end
end
