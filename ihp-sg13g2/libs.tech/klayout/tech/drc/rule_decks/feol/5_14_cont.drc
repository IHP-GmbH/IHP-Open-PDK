if TABLES.include?('cont') || FEOL
  #==============================================
  #----------------- 5.14. Cont -----------------
  #==============================================

  logger.info('Starting 5.14. Cont table')

  # Cont derivations
  act_sram = activ_drw.and(sram_drw)
  act_nsram = activ_drw.not(sram_drw)
  cont_nsvaricap = cont_sq.not(svaricap)

  # Rule Cnt.a: Min. and max. Cont width is 0.16µm
  # Per spec section 5.14: applies only to square-shaped Cont (non-squares are ContBar).
  # cont_sq = squares only (from orchestrator non_squares split).
  logger.info('Executing rule Cnt.a')
  cnt_a_value = drc_rules['Cnt_a'].to_f
  cnt_a_l = cont_sq.without_bbox_width(cnt_a_value.um)
  cnt_a_l.output('Cnt.a', "5.14. Cnt.a : Min. and max. Cont width: #{cnt_a_value} µm")
  cnt_a_l.forget

  # Rule Cnt.b: Min. Cont space is 0.18µm
  logger.info('Executing rule Cnt.b')
  cnt_b_value = drc_rules['Cnt_b'].to_f
  cnt_b_l = cont_sq.space(cnt_b_value.um, euclidian)
  cnt_b_l.output('Cnt.b', "5.14. Cnt.b : Min. Cont space: #{cnt_b_value} µm")
  cnt_b_l.forget

  unless PRECHECK_DRC
    # Rule Cnt.b1: Min. Cont space in a contact array of more than 4 rows and more than 4 columns is 0.20 um
    logger.info('Executing rule Cnt.b1')
    cnt_b1_value = drc_rules['Cnt_b1'].to_f
    cnt_b1_nr = drc_rules['Cnt_b1_nr'].to_i
    cnt_b1_pitch = (cnt_b1_nr * cnt_a_value + (cnt_b1_nr - 1) * cnt_b_value) / 2.0
    cnt_b1_l1 = cont_sq.sized((cnt_b1_value * 0.5).um).sized(-(cnt_b1_value * 0.5).um)
    cnt_b1_large = cnt_b1_l1.sized(-(cnt_b1_pitch - 0.001).um).sized((cnt_b1_pitch - 0.001).um)
    cnt_b1_inside = cont_sq.inside(cnt_b1_large)
    cnt_b1_merged = cnt_b1_inside.sized((cnt_b1_value / 2.0 - 0.001).um).sized(-(cnt_b1_value / 2.0 - 0.001).um)
    cnt_b1_bad = cnt_b1_merged.not(cnt_b1_inside)
    cnt_b1_l = cnt_b1_bad.not_rectangles
    cnt_b1_l.output('Cnt.b1',
                     "5.14. Cnt.b1 Min. Cont space in a contact array of more than #{cnt_b1_nr} rows and more than #{cnt_b1_nr} columns is #{cnt_b1_value} um")
    cnt_b1_l1.forget
    cnt_b1_large.forget
    cnt_b1_inside.forget
    cnt_b1_merged.forget
    cnt_b1_bad.forget
    cnt_b1_l.forget

    # Rule Cnt.c: Min. Activ enclosure of Cont is 0.07 um
    logger.info('Executing rule Cnt.c')
    cnt_c_value = drc_rules['Cnt_c'].to_f
    cnt_c_act = act_nsram.join(activ_mask).not(digibnd_drw)
    cnt_c_l = cont_nsvaricap.enclosed(cnt_c_act, cnt_c_value.um, euclidian)
    cnt_c_l.output('Cnt.c', "5.14. Cnt.c Min. Activ enclosure of Cont is #{cnt_c_value} um")
    cnt_c_l.forget
    cnt_c_act.forget

    # Rule Cnt.c.Digi: Min. Activ enclosure of Cont inside DigiBnd is 0.05 um
    logger.info('Executing rule Cnt.c.Digi')
    cnt_c_digi_value = drc_rules['Cnt_c_digibnd'].to_f
    cnt_c_digi_l1 = cont_sq.not(trans_drw).enclosed(activ_drw.and(digibnd_drw), cnt_c_digi_value.um, euclidian)
    cnt_c_digi_l1.output('Cnt.c.Digi', "5.14. Cnt.c.Digi Min. Activ enclosure of Cont inside DigiBnd is #{cnt_c_digi_value} um")
    cnt_c_digi_l1.forget

    # Rule Cnt.c.digibnd: Min. Activ enclosure of Cont (Inside DigiBnd) is 0.05 um
    logger.info('Executing rule Cnt.c.digibnd')
    cnt_c_digibnd_value = drc_rules['Cnt_c_digibnd'].to_f
    cnt_c_digibnd_act = act_nsram.join(activ_mask).and(digibnd_drw)
    cnt_c_l_digibnd = cont_nsvaricap.enclosed(cnt_c_digibnd_act, cnt_c_digibnd_value.um, euclidian)
    cnt_c_l_digibnd.output('Cnt.c.digibnd', "8.1.2. Cnt.c.digibnd Min. Activ enclosure of Cont (Inside DigiBnd) is #{cnt_c_digibnd_value} um")
    cnt_c_l_digibnd.forget
    cnt_c_digibnd_act.forget

    # Rule Cnt.c.SRAM: Min. Activ enclosure of Cont (Inside SRAM) is 0.006 um
    logger.info('Executing rule Cnt.c.SRAM')
    cnt_c_sram_value = drc_rules['Cnt_c_sram'].to_f
    cnt_c_l_sram = cont_nsvaricap.enclosed(act_sram, cnt_c_sram_value.um, euclidian)
    cnt_c_l_sram.output('Cnt.c.SRAM', "8.3. Cnt.c.SRAM Min. Activ enclosure of Cont (Inside SRAM) is #{cnt_c_sram_value} um")
    cnt_c_l_sram.forget

    # Rule Cnt.d: Min. GatPoly enclosure of Cont is 0.07 um
    logger.info('Executing rule Cnt.d')
    cnt_d_value = drc_rules['Cnt_d'].to_f
    cnt_d_l = cont_sq.enclosed(gatpoly_drw, cnt_d_value.um, euclidian)
    cnt_d_l.output('Cnt.d', "5.14. Cnt.d Min. GatPoly enclosure of Cont is #{cnt_d_value} um")
    cnt_d_l.forget

    # Rule Cnt.e: Min. Cont on GatPoly space to Activ is 0.14 um
    logger.info('Executing rule Cnt.e')
    cnt_e_value = drc_rules['Cnt_e'].to_f
    cnt_e_l1 = cont_sq.and(gatpoly_drw).not(svaricap)
    cnt_e_l = cnt_e_l1.sep(activ_drw, cnt_e_value.um, euclidian)
    cnt_e_l.output('Cnt.e', "5.14. Cnt.e Min. Cont on GatPoly space to Activ is #{cnt_e_value} um")
    cnt_e_l1.forget
    cnt_e_l.forget

    # Rule Cnt.f: Min. Cont on Activ space to GatPoly is 0.11 um
    logger.info('Executing rule Cnt.f')
    cnt_f_value = drc_rules['Cnt_f'].to_f
    cnt_f_l1 = cont_sq.and(activ_drw)
    gp_not_sram = gatpoly_drw.not(sram_drw)
    cnt_f_l = cnt_f_l1.separation(gp_not_sram, cnt_f_value.um, euclidian)
    cnt_f_l.output('Cnt.f', "5.14. Cnt.f Min. Cont on Activ space to GatPoly is #{cnt_f_value} um")
    cnt_f_l1.forget
    gp_not_sram.forget
    cnt_f_l.forget

    # Rule Cnt.g: Cont must be within Activ or GatPoly
    logger.info('Executing rule Cnt.g')
    gp_or_act = gatpoly_drw.join(activ_drw)
    cnt_g_l = cont_sq.not(gp_or_act).outside(trans_drw)
    cnt_g_l.output('Cnt.g', '5.14. Cnt.g Cont must be within Activ or GatPoly')
    gp_or_act.forget
    cnt_g_l.forget

    # Rule Cnt.g1: Min. pSD space to Cont on nSD-Activ is 0.09 um
    logger.info('Executing rule Cnt.g1')
    cnt_g1_value = drc_rules['Cnt_g1'].to_f
    cnt_g1_l1 = cont_sq.and(nactiv).not(svaricap)
    cnt_g1_l = cnt_g1_l1.sep(psd_drw, cnt_g1_value.um, euclidian)
    cnt_g1_l.output('Cnt.g1', "5.14. Cnt.g1 Min. pSD space to Cont on nSD-Activ is #{cnt_g1_value} um")
    cnt_g1_l1.forget
    cnt_g1_l.forget

    # Rule Cnt.g2: Min. pSD overlap of Cont on pSD-Activ is 0.09 um
    logger.info('Executing rule Cnt.g2')
    cnt_g2_value = drc_rules['Cnt_g2'].to_f
    cnt_g2_l1 = cont_sq.and(pactiv).not(svaricap)
    cnt_g2_l = cnt_g2_l1.enclosed(psd_drw, cnt_g2_value.um, euclidian)
    cnt_g2_l.output('Cnt.g2', "5.14. Cnt.g2 Min. pSD overlap of Cont on pSD-Activ is #{cnt_g2_value} um")
    cnt_g2_l1.forget
    cnt_g2_l.forget

    # Rule Cnt.h: Cont must be covered with Metal1
    logger.info('Executing rule Cnt.h')
    cnt_h_l = cont_sq.not(metal1_drw)
    cnt_h_l.output('Cnt.h', '5.14. Cnt.h Cont must be covered with Metal1')
    cnt_h_l.forget

    # Rule Cnt.j: Cont on GatPoly over Activ is not allowed
    logger.info('Executing rule Cnt.j')
    cnt_j_l = cont_sq.and(activ_drw.and(gatpoly_drw))
    cnt_j_l.output('Cnt.j', '5.14. Cnt.j Cont on GatPoly over Activ is not allowed')
    cnt_j_l.forget
  end
end
