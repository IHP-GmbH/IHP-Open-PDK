#==========================================
# ------- CAP_CMOM CONNECTIONS ------------
#==========================================

logger.info('Starting CAP_CMOM CONNECTIONS')

# Connect each metal's port pins ONLY to that same metal (per-layer). This keeps
# the two 'same'-feed terminals apart: PLUS sits on the mmax metal and MINUS on
# the mmax-1 metal stacked directly below it, so a merged 'connect ports to all
# metals' would short them through the pin overlap. Each comb's full Metal1..Metal5
# stack is already tied together by the core via stacks (general_connections
# stitches Metal-Via-Metal up to Via4/Metal5), so per-layer pin connection is
# sufficient for net tracing.
connect(cap_cmomi_m1_ports, metal1_con)
connect(cap_cmomi_m2_ports, metal2_con)
connect(cap_cmomi_m3_ports, metal3_con)
connect(cap_cmomi_m4_ports, metal4_con)
connect(cap_cmomi_m5_ports, metal5_con)
