#========================================
# -------- CAP_CMOM DERIVATIONS ---------
#========================================

logger.info('Starting CAP_CMOM DERIVATIONS')

# The cap_cmomi device is identified by the recog_mom marker (Recog.mom, GDS 99/39).
# The PCell paints this marker over the full device area. cap_cmomi owns Recog.mom
# by design: it is the MOM capacitor on the g2 thin-metal stack (Metal1..Metal5).
cap_cmomi_marker = recog_mom

# Device marker for extraction
cap_cmomi_dev_mk = cap_cmomi_marker

# Port identification: metal pin shapes within the device marker.
# The PCell places two MkPin shapes (PLUS = pin 1, MINUS = pin 2). For 'double'
# both sit on the top metal (different x); for 'same' they are STACKED on
# adjacent metals (mmax over mmax-1) at the same x,y.
#
# Per-metal port layers: keep the metal identity so connectivity can tie each
# pin ONLY to its own metal. Two stacked pins (same x,y, different metals) would
# otherwise bridge if a single merged port layer were connected to every metal.
cap_cmomi_m1_ports = metal1_pin.and(cap_cmomi_marker)
cap_cmomi_m2_ports = metal2_pin.and(cap_cmomi_marker)
cap_cmomi_m3_ports = metal3_pin.and(cap_cmomi_marker)
cap_cmomi_m4_ports = metal4_pin.and(cap_cmomi_marker)
cap_cmomi_m5_ports = metal5_pin.and(cap_cmomi_marker)
