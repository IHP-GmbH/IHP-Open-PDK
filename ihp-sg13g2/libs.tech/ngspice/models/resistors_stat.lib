* NOTE:
* values are one-sigma deviations (1/3 of min-max)

* ngspice global statistical parameters
* global number of standard deviations
.param mc_nsig_rsh_rsil  = 'agauss(0, 1, 1)'
.param mc_nsig_w_rsil    = 'agauss(0, 1, 1)'
.param mc_nsig_l_rsil    = 'agauss(0, 1, 1)'
.param mc_nsig_rsh_rppd  = 'agauss(0, 1, 1)'
.param mc_nsig_w_rppd    = 'agauss(0, 1, 1)'
.param mc_nsig_l_rppd    = 'agauss(0, 1, 1)'
.param mc_nsig_rsh_rhigh = 'agauss(0, 1, 1)'
.param mc_nsig_w_rhigh   = 'agauss(0, 1, 1)'
.param mc_nsig_l_rhigh   = 'agauss(0, 1, 1)'
.param nsig_rsh_rsil  = mc_nsig_rsh_rsil
.param nsig_w_rsil    = mc_nsig_w_rsil
.param nsig_l_rsil    = mc_nsig_l_rsil
.param nsig_rsh_rhigh = mc_nsig_rsh_rhigh
.param nsig_w_rhigh   = mc_nsig_w_rhigh
.param nsig_l_rhigh   = mc_nsig_l_rhigh
.param nsig_rsh_rppd  = mc_nsig_rsh_rppd
.param nsig_w_rppd    = mc_nsig_w_rppd
.param nsig_l_rppd    = mc_nsig_l_rppd

* global variation standard deviation
.param drsh_rsil  = 4.67 ; % of 1 Sigma
.param drsh_rppd  = 3.3  ; % of 1 Sigma
.param drsh_rhigh = 5.1  ; % of 1 Sigma
.param dl_rsil    = 0.01 ; um of 1 Sigma
.param dw_rsil    = 0.01 ; um of 1 Sigma
.param dl_rppd    = 0.01 ; um of 1 Sigma
.param dw_rppd    = 0.01 ; um of 1 Sigma
.param dl_rhigh   = 0.02 ; um of 1 Sigma
.param dw_rhigh   = 0.02 ; um of 1 Sigma
