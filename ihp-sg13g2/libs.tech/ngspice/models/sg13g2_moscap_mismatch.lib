* ngspice MOSCAP mismatch parameters
.param sg13g2_moscap_n_delvto_mm  = 0.0039
.param sg13g2_moscap_n_factuo_mm  = 0.005
.param sg13g2_moscap_n_dw_mm      = 4e-9
.param sg13g2_moscap_n_dl_mm      = 2e-9

.param sg13g2_moscap_p_delvto_mm  = 0.0022
.param sg13g2_moscap_p_factuo_mm  = 0.0033
.param sg13g2_moscap_p_dw_mm      = 4e-9
.param sg13g2_moscap_p_dl_mm      = 2e-9
