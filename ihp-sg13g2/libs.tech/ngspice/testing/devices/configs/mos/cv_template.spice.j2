* MOS capacitance-meter netlist, rendered per measured C-V block and corner
* (models_verifier/cv_runner/cv_sweep_runner.py).
*
* The HIGH pins (node nh) carry the measured bias plus a 1 V AC excitation; each LOW pin sits at
* 0 V through a source whose AC current is read (nodes nl_<pin>); FLOAT pins are open for AC
* and tied for DC through 1e12 ohm to `float_to`; every other pin is AC ground (node 0).
* One single-frequency AC analysis per bias point: C = sum over LOW pins of Im(I) / (2 pi f).
* AS is kept above 0 (1e-30): the subcircuit recomputes the whole junction geometry from W and
* NF when as = 0, which would drop the header's drain area/perimeter.
* Output: one row "frequency sweep c" per simulated bias point in {{ out_path }}.

Vh nh 0 dc {{ sweep_values[0] }} ac 1
{% for p in low_pins %}
Vl_{{ p }} nl_{{ p }} 0 0
{% endfor %}
{% for p in float_pins %}
Rfl_{{ p }} nf_{{ p }} {{ float_to }} 1e12
{% endfor %}

.param W={{ W }}
.param L={{ L }}
.param AD={{ AD }}
.param AS={{ AS if AS > 0 else 1e-30 }}
.param PD={{ PD }}
.param PS={{ PS }}
.param NF={{ NF }}
.param M={{ M }}

XU1 {{ nodes | join(' ') }} {{ device_subckt }}
+ w={W} l={L} m={M} ng={NF} ad={AD} as={AS} pd={PD} ps={PS}

.temp {{ TEMP }}

.control
  * One row "frequency sweep c" per bias point, appended with full precision. "destroy all" first:
  * if the AC analysis of a point fails, no row is written (the point then counts as not
  * simulated) instead of reading the previous point's result.
  set filetype=ascii
  set wr_singlescale
  set appendwrite
  set numdgt=12
  foreach vsw {{ sweep_values | join(' ') }}
    destroy all
    alter Vh dc = $vsw
    ac lin 1 {{ freq }} {{ freq }}
    let sweep = $vsw
    let c = ({% for p in low_pins %}imag(i(Vl_{{ p }})) + {% endfor %}0) / (2*pi*{{ freq }})
    wrdata {{ out_path }} sweep c
  end
  quit
.endc

.lib {{ model_corner_lib }} {{ corner }}

.end
