<?xml version="1.0"?>
<Component
  xsi:noNamespaceSchemaLocation="Component.xsd"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  library="IHP SG13G2 devices" names="cap_cmomi" schematic_id = "C">
    <Description>
        SG13G2 interdigitated MoM capacitor
    </Description>
    <Models>
            <DefaultModel value="cmomi">
            </DefaultModel>
            <SpiceModel value="cmomi">
            </SpiceModel>
    </Models>
    <Netlists>
        <NgspiceNetlist value=
            "{{{Letter}}}::schematic_id='nequal'C{PartCounter} {nets} {{{model}}}::model='nonempty'
            {{w={w}}}::w='nonempty' {{l={l}}}::l='nonempty' mmin={mmin} mmax={mmax} feed={feed} subblock={subblock} m={m} mm_ok={mm_ok}">
        </NgspiceNetlist>
        <CDLNetlist value=
            "{{{Letter}}}::schematic_id='nequal'C{PartCounter} {nets} {{{model}}}::model='nonempty'
            {{w={w}}}::w='nonempty' {{l={l}}}::l='nonempty' mmin={mmin} mmax={mmax} feed={feed} subblock={subblock} m={m}">
        </CDLNetlist>
        <XyceNetlist value=
            "{{{Letter}}}::schematic_id='nequal'C{PartCounter} {nets} {{{model}}}::model='nonempty'
            {{w={w}}}::w='nonempty' {{l={l}}}::l='nonempty' mmin={mmin} mmax={mmax} feed={feed} subblock={subblock} m={m}">
        </XyceNetlist>
   </Netlists>
    <Symbols>
        <Symbol id="Standard">
            <File>{QUCS_S_COMPONENTS_LIBRARY}/cap_cmomi.sym</File>
        </Symbol>
    </Symbols>
    <Parameters>
        <Parameter name="model" unit="" default_value="cap_cmomi" show="false">
            <Description>Model name</Description>
        </Parameter>
        <Parameter name="Letter" unit="" default_value="X" show="false">
            <Description>Spice prefix</Description>
        </Parameter>
        <Parameter name="w" unit="u" default_value="5.0" show="true">
            <Description>Width (Y, row stacking)</Description>
        </Parameter>
        <Parameter name="l" unit="u" default_value="5.0" show="true">
            <Description>Length (X, finger length)</Description>
        </Parameter>
        <Parameter name="mmin" unit="" default_value="1" show="true">
            <Description>Bottom metal index (1=Metal1)</Description>
        </Parameter>
        <Parameter name="mmax" unit="" default_value="5" show="true">
            <Description>Top metal index (5=Metal5)</Description>
        </Parameter>
        <Parameter name="feed" unit="" default_value="double" show="true">
            <Description>[none,same,double]</Description>
        </Parameter>
        <Parameter name="subblock" unit="" default_value="0" show="false">
            <Description>Add substrate isolation block [0,1]</Description>
        </Parameter>
        <Parameter name="m" unit="" default_value="1" show="true">
            <Description>Multiplier</Description>
        </Parameter>
        <Parameter name="C" unit="F" equation="m*((mmax-mmin+1&lt;=2)?0.55:((mmax-mmin+1==3)?0.82:((mmax-mmin+1==4)?1.09:1.36)))*(max(1,rint(l*1e6/0.84+1e-6-0.5))*0.84)*(max(1,rint(w*1e6/0.89+1e-6-0.5)-1)*0.89)*1e-15" show="true">
            <Description>Estimated capacitance (feed=double active area)</Description>
        </Parameter>
        <Parameter name="mm_ok" unit="" default_value="1" show="false">
            <Description>[0,1] reserved, no characterised mismatch model</Description>
        </Parameter>
    </Parameters>
</Component>
