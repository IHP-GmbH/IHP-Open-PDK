<?xml version="1.0"?>
<Component
  xsi:noNamespaceSchemaLocation="Component.xsd"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  library="IHP SG13G2 devices" names="lvsres" schematic_id = "R">
    <Description>
        SG13G2  LVS resistor
    </Description>
    <Models>
        <DefaultModel value="lvsres">
        </DefaultModel>
        <SpiceModel value="lvsres">
        </SpiceModel>
    </Models>
    <Netlists>
        <NgspiceNetlist value = "{{{Letter}}}::schematic_id='nequal'R{PartCounter} {nets} {r} {model} {{layer={layer}}}::layer='nonempty' {{w={w}}}::w='nonempty' {{l={l}}}::l='nonempty'"> </NgspiceNetlist>
        <CDLNetlist value = "{{{Letter}}}::schematic_id='nequal'R{PartCounter} {nets} {model} {{layer={layer}}}::layer='nonempty' {{w={w}}}::w='nonempty' {{l={l}}}::l='nonempty'"> </CDLNetlist>
        <XyceNetlist value = "{{{Letter}}}::schematic_id='nequal'R{PartCounter} {nets} {r} {model} {{layer={layer}}}::layer='nonempty' {{w={w}}}::w='nonempty' {{l={l}}}::l='nonempty'"> </XyceNetlist>
    </Netlists>
    <Symbols>
        <Symbol id="Standard">
           <File>{QUCS_S_COMPONENTS_LIBRARY}/ResistorEU.sym</File>
        </Symbol>
    </Symbols>
    <Parameters>
        <Parameter name="Letter" unit="" default_value="X" show="false">
            <Description>Spice prefix</Description>
        </Parameter>
        <Parameter name="model" unit="" default_value="lvsres" show="true">
            <Description>Device Model</Description>
        </Parameter>
        <Parameter name="w" unit="u" default_value="5" show="true">
            <Description>Width</Description>
        </Parameter>
        <Parameter name="l" unit="u" default_value="1" show="true">
            <Description>Length</Description>
        </Parameter>
        <Parameter name="layer" unit="" default_value="Metal1" show="true">
            <Description>[Metal1,Metal2,Metal3,Metal4,Metal5,TopMetal1,TopMetal2]</Description>
        </Parameter>
        <Parameter name="r" unit="u" default_value="1" show="true">
            <Description>Resistance value</Description>
        </Parameter>
    </Parameters>
</Component>
