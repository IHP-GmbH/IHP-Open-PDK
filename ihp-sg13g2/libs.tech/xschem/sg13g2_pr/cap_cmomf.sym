K {type=capacitor
format="@spiceprefix@name @pinlist @model w=@w l=@l mmin=@mmin mmax=@mmax subblock=@subblock m=@m mm_ok=@mm_ok"
lvs_format="C@name @pinlist @model w=@w l=@l m=@m"
template="name=C1
model=cap_cmomf
w=5e-6
l=5e-6
mmin=1
mmax=5
subblock=0
m=1
mm_ok=1
spiceprefix=X
"
}
V {}
S {}
F {}
E {}
L 4 0 5 0 30 {}
L 4 0 -30 0 -5 {}
L 4 -10 -5 10 -5 {}
L 4 -10 5 10 5 {}
B 5 -2.5 -32.5 2.5 -27.5 {name=c0 dir=inout}
B 5 -2.5 27.5 2.5 32.5 {name=c1 dir=inout}
T {@name} 15 -28.75 0 0 0.2 0.2 {}
T {@model} 15 -19.5 0 0 0.2 0.2 {}
T {tcleval(C=[ev \{@m * ( ((@mmin == 1) ? 0.372 : 0.305) + max(0, @mmax - @mmin ) * 0.305 ) * ( @l * 1e6 ) * ( @w * 1e6 ) * 1e-15\}])} 15 -10.25 0 0 0.2 0.2 {layer=13}
T {@w / @l} 15 -1 0 0 0.2 0.2 {layer=13}
T {M@mmin - M@mmax} 15 8.25 0 0 0.2 0.2 {layer=13}
T {m=@m} 15 17.5 0 0 0.15 0.15 {layer=13}
T {c0} 5 -27.5 0 0 0.15 0.15 {layer=7}
T {c1} 5 18.75 0 0 0.15 0.15 {layer=7}
