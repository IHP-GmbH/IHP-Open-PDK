*******************************************************************************
*                                                                             *
*                           M O S C A P   C O R N E R S                       *
*                                                                             *
*******************************************************************************
*
* MOS capacitors use the low-voltage MOS PSP103 model cards with dedicated
* two-terminal MOSCAP subcircuits.  Keep this corner entry point separate from
* cornerMOSlv.lib so MOSCAP users do not include MOS transistor wrappers.
*

.LIB moscap_tt
.param sg13g2_moscap_n_vfbo_mm= 1.0
.param sg13g2_moscap_n_ctl    = 1.2080
.param sg13g2_moscap_n_rsw1   = 0.7200
.param sg13g2_moscap_n_muew   = 0.8500
.param sg13g2_moscap_n_dphibo = 0.9915
.param sg13g2_moscap_n_dphibl = 0.9693
.param sg13g2_moscap_n_dphibw = 0.9749
.param sg13g2_moscap_n_dphiblw= 0.9754
.param sg13g2_moscap_n_themuo = 0.8757
.param sg13g2_moscap_n_thesatl= 0.7850
.param sg13g2_moscap_n_thesatw= 1.5000
.param sg13g2_moscap_n_thesatlw= 0.6127
.param sg13g2_moscap_n_toxo   = 1.0000
.param sg13g2_moscap_n_toxovo = 1.0000
.param sg13g2_moscap_n_cjorbot= 1.0000
.param sg13g2_moscap_n_cjorsti= 1.0000
.param sg13g2_moscap_n_cjorgat= 1.0000

.param sg13g2_moscap_p_vfbo_mm   = 1.0
.param sg13g2_moscap_p_ctl    = 1.9570
.param sg13g2_moscap_p_rsw1   = 0.7720
.param sg13g2_moscap_p_muew   = 1.0520
.param sg13g2_moscap_p_dphibo = 0.9050
.param sg13g2_moscap_p_dphibl = 0.8550
.param sg13g2_moscap_p_dphibw = -1.5800
.param sg13g2_moscap_p_dphiblw= 1.0000
.param sg13g2_moscap_p_themuo = 0.9580
.param sg13g2_moscap_p_thesatl= 0.5510
.param sg13g2_moscap_p_thesatw= 1.0800
.param sg13g2_moscap_p_thesatlw= 1.0000
.param sg13g2_moscap_p_toxo   = 1.0000
.param sg13g2_moscap_p_toxovo = 1.0000
.param sg13g2_moscap_p_cjorbot= 1.0000
.param sg13g2_moscap_p_cjorsti= 1.0000
.param sg13g2_moscap_p_cjorgat= 1.0000

.include sg13g2_moscap_mod.lib
.ENDL moscap_tt

* Typical with mismatch
.LIB moscap_tt_mismatch
.param sg13g2_moscap_n_vfbo_mm= 1.0
.param sg13g2_moscap_n_ctl    = 1.2080
.param sg13g2_moscap_n_rsw1   = 0.7200
.param sg13g2_moscap_n_muew   = 0.8500
.param sg13g2_moscap_n_dphibo = 0.9915
.param sg13g2_moscap_n_dphibl = 0.9693
.param sg13g2_moscap_n_dphibw = 0.9749
.param sg13g2_moscap_n_dphiblw= 0.9754
.param sg13g2_moscap_n_themuo = 0.8757
.param sg13g2_moscap_n_thesatl= 0.7850
.param sg13g2_moscap_n_thesatw= 1.5000
.param sg13g2_moscap_n_thesatlw= 0.6127
.param sg13g2_moscap_n_toxo   = 1.0000
.param sg13g2_moscap_n_toxovo = 1.0000
.param sg13g2_moscap_n_cjorbot= 1.0000
.param sg13g2_moscap_n_cjorsti= 1.0000
.param sg13g2_moscap_n_cjorgat= 1.0000

.param sg13g2_moscap_p_vfbo_mm   = 1.0
.param sg13g2_moscap_p_ctl    = 1.9570
.param sg13g2_moscap_p_rsw1   = 0.7720
.param sg13g2_moscap_p_muew   = 1.0520
.param sg13g2_moscap_p_dphibo = 0.9050
.param sg13g2_moscap_p_dphibl = 0.8550
.param sg13g2_moscap_p_dphibw = -1.5800
.param sg13g2_moscap_p_dphiblw= 1.0000
.param sg13g2_moscap_p_themuo = 0.9580
.param sg13g2_moscap_p_thesatl= 0.5510
.param sg13g2_moscap_p_thesatw= 1.0800
.param sg13g2_moscap_p_thesatlw= 1.0000
.param sg13g2_moscap_p_toxo   = 1.0000
.param sg13g2_moscap_p_toxovo = 1.0000
.param sg13g2_moscap_p_cjorbot= 1.0000
.param sg13g2_moscap_p_cjorsti= 1.0000
.param sg13g2_moscap_p_cjorgat= 1.0000

.include sg13g2_moscap_mismatch.lib
.include sg13g2_moscap_mod_mismatch.lib
.ENDL moscap_tt_mismatch

.LIB moscap_tt_stat
.param sg13g2_moscap_n_vfbo_norm   = 1.0
.param sg13g2_moscap_n_ctl_norm    = 1.2080
.param sg13g2_moscap_n_rsw1_norm   = 0.7200
.param sg13g2_moscap_n_muew_norm   = 0.8500
.param sg13g2_moscap_n_dphibo_norm = 0.9915
.param sg13g2_moscap_n_dphibl_norm = 0.9693
.param sg13g2_moscap_n_dphibw_norm = 0.9749
.param sg13g2_moscap_n_dphiblw_norm= 0.9754
.param sg13g2_moscap_n_themuo_norm = 0.8757
.param sg13g2_moscap_n_thesatl_norm= 0.7850
.param sg13g2_moscap_n_thesatw_norm= 1.5000
.param sg13g2_moscap_n_thesatlw_norm= 0.6127
.param sg13g2_moscap_n_toxo_norm   = 1.0000
.param sg13g2_moscap_n_toxovo_norm = 1.0000
.param sg13g2_moscap_n_cjorbot_norm= 1.0000
.param sg13g2_moscap_n_cjorsti_norm= 1.0000
.param sg13g2_moscap_n_cjorgat_norm= 1.0000

.param sg13g2_moscap_p_vfbo_norm   = 1.0
.param sg13g2_moscap_p_ctl_norm    = 1.9570
.param sg13g2_moscap_p_rsw1_norm   = 0.7720
.param sg13g2_moscap_p_muew_norm   = 1.0520
.param sg13g2_moscap_p_dphibo_norm = 0.9050
.param sg13g2_moscap_p_dphibl_norm = 0.8550
.param sg13g2_moscap_p_dphibw_norm = -1.5800
.param sg13g2_moscap_p_dphiblw_norm= 1.0000
.param sg13g2_moscap_p_themuo_norm = 0.9580
.param sg13g2_moscap_p_thesatl_norm= 0.5510
.param sg13g2_moscap_p_thesatw_norm= 1.0800
.param sg13g2_moscap_p_thesatlw_norm= 1.0000
.param sg13g2_moscap_p_toxo_norm   = 1.0000
.param sg13g2_moscap_p_toxovo_norm = 1.0000
.param sg13g2_moscap_p_cjorbot_norm= 1.0000
.param sg13g2_moscap_p_cjorsti_norm= 1.0000
.param sg13g2_moscap_p_cjorgat_norm= 1.0000


.include sg13g2_moscap_stat.lib

.param sg13g2_moscap_n_vfbo_mm = sg13g2_moscap_n_vfbo
.param sg13g2_moscap_p_vfbo_mm = sg13g2_moscap_p_vfbo

.include sg13g2_moscap_mod.lib
.ENDL moscap_tt_stat
